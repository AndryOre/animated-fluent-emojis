{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "all",
  "semi": false,
  "tabWidth": 2,
  "singleQuote": true,
  "printWidth": 80,
  "proseWrap": "always",
  "endOfLine": "lf",
  "arrowParens": "always",
  "sortPackageJson": false,
  "sortImports": {
    "ignoreCase": true,
    "newlinesBetween": true,
    "internalPattern": ["@/"],
    "customGroups": [
      {
        "groupName": "astro",
        "elementNamePattern": ["astro", "astro/**", "astro:*"]
      }
    ],
    "groups": [
      "builtin",
      { "newlinesBetween": false },
      ["external", "astro"],
      "internal",
      ["parent", "sibling", "index"],
      "unknown"
    ]
  },
  "sortTailwindcss": {
    "stylesheet": "./apps/site/src/styles/global.css",
    "functions": ["cn", "cva", "clsx"]
  },
  "astro": {},
  "associations": [
    {
      "files": ["*.astro"],
      "language": "astro"
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "**/dist",
    "bun.lock",
    "**/coverage",
    ".claude/worktrees",
    "**/.astro",
    ".claude/skills",
    "**/*.html"
  ]
}
