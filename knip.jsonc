{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["ffmpeg", "ffprobe"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts", "eslint-rules/index.mjs"],
    },
    "apps/assets": {
      "entry": ["*.test.ts"],
      "ignoreDependencies": ["animated-fluent-emojis"],
      "project": ["*.ts"],
    },
    "apps/site": {
      "ignoreDependencies": ["@lucide/astro"],
      "entry": [
        "src/gallery/index.ts",
        "src/docs/install-block-client.ts",
        "playwright.visual.config.ts",
        "e2e-visual/*.spec.ts",
      ],
    },
    "packages/animated-fluent-emojis": {
      "entry": [
        "src/index.ts",
        "src/react/index.ts",
        "src/lookup/index.ts",
        "src/vanilla/create-emoji.ts",
        "src/element/index.ts",
        "src/vue/index.ts",
        "src/svelte/index.ts",
        "src/svelte/runtime.ts",
        "src/svelte/Emoji.d.svelte.ts",
        "src/astro/index.ts",
        "src/astro/client.ts",
        "src/astro/server.ts",
      ],
    },
  },
}
