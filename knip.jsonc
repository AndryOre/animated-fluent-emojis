{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/react/index.ts",
    "src/lookup/index.ts",
    "src/vanilla/create-emoji.ts",
    "src/element/index.ts",
    "src/svelte/index.ts",
