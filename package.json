{
  "name": "animated-fluent-emojis",
  "version": "0.1.2",
  "description": "Animated Fluent Emojis is a React component library that brings Microsoft's Fluent emojis to life in your web applications. This library offers an easy way to integrate expressive and engaging animated emojis, enhancing user experience and visual appeal in your React projects.",
  "author": "Andry Orellana",
  "license": "ISC",
  "private": false,
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "keywords": [
    "react",
    "emojis",
    "animated",
    "fluent",
    "icons",
    "microsoft",
    "animated-emojis",
    "fluent-emojis",
    "emoji-library",
    "ui",
    "emoticons",
    "animation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndryOre/animated-fluent-emojis.git"
  },
  "homepage": "https://github.com/AndryOre/animated-fluent-emojis#readme",
  "bugs": "https://github.com/AndryOre/animated-fluent-emojis/issues",
  "module": "./dist/animated-fluent-emojis.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/animated-fluent-emojis.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0 --cache --cache-strategy content",
    "lint:fix": "eslint . --fix --cache --cache-strategy content",
    "typecheck": "tsc -b",
    "knip": "knip",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,json5,md,css,yml,yaml}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,json5,md,css,yml,yaml}\" --cache",
    "lint:package": "bun run build && publint --strict && attw --pack . --profile esm-only",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run lint:package",
    "fix": "bun run format:write && bun run lint:fix && bun run typecheck",
    "size": "size-limit",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:docs": "bun scripts/lint-docs.ts",
    "lint:commits": "bun scripts/lint-commits.ts",
    "ci:local": "bun install --frozen-lockfile && bun run lint:commits && bun run lint:docs && bun run check && bun run test:coverage && bun run build && bun run size"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-react/eslint-plugin": "^5.24.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@size-limit/file": "^14.1.0",
    "@types/node": "^22.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/browser-playwright": "^5",
    "@vitest/coverage-v8": "^5",
    "axe-core": "^4.13.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^76",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "msw": "^3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5",
    "vitest-browser-react": "^2.3.0",
    "yaml": "^2.9.1"
  },
  "size-limit": [
    {
      "name": "ESM bundle",
      "path": "dist/animated-fluent-emojis.js",
      "limit": "1.6 kB"
    },
    {
      "name": "Stylesheet",
      "path": "dist/style.css",
      "limit": "125 B"
    }
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
