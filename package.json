{
  "name": "animated-fluent-emojis-monorepo",
  "description": "Microsoft's animated Fluent emojis as one component. They play on load or hover, rest under reduced motion and hold their space while they load.",
  "keywords": [
    "react",
    "react-component",
    "vue",
    "vue-component",
    "svelte",
    "svelte-component",
    "astro-component",
    "web-component",
    "custom-element",
    "angular",
    "solid",
    "preact",
    "emoji",
    "emojis",
    "animated",
    "animated-emoji",
    "animated-emojis",
    "fluent",
    "fluent-emoji",
    "fluent-emojis",
    "microsoft",
    "animation",
    "emoticons",
    "typescript"
  ],
  "homepage": "https://animated-fluent-emojis.andryore.dev",
  "bugs": {
    "url": "https://github.com/AndryOre/animated-fluent-emojis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndryOre/animated-fluent-emojis.git"
  },
  "license": "MIT",
  "author": "Andry Orellana",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@vitest/browser-playwright": "^5.0.5",
      "@vitest/coverage-v8": "^5.0.5",
      "astro": "^7.4.4",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "svelte": "^5.57.3",
      "typescript": "~6.0.3",
      "vite": "^8.3.5",
      "vitest": "^5.0.5",
      "vue": "^3.5.44"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@shadcn/lint": "^0.2.3",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "^1.6.28",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "77.0.0",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.1",
    "typescript7": "npm:typescript@7.1.0-beta",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "clean": "rm -rf apps/assets/node_modules apps/assets/dist-assets apps/assets/dist-files apps/assets/.cache apps/site/node_modules apps/site/dist apps/site/.astro packages/animated-fluent-emojis/node_modules packages/animated-fluent-emojis/dist .turbo node_modules",
    "cache:clear": "rm -rf .eslintcache .turbo node_modules/.cache",
    "dev": "bun run --cwd packages/animated-fluent-emojis dev",
    "build": "turbo run build",
    "lint": "oxlint --type-aware --deny-warnings && eslint '**/*.astro' --max-warnings=0 --cache --cache-strategy content",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix && eslint '**/*.astro' --fix --max-warnings=0 --cache --cache-strategy content",
    "typecheck": "turbo run typecheck && node_modules/typescript7/bin/tsc --noEmit",
    "knip": "knip",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,js,jsx,mjs,astro,json,json5,md,css,yml,yaml}\"",
    "format:write": "oxfmt --write \"**/*.{ts,tsx,js,jsx,mjs,astro,json,json5,md,css,yml,yaml}\"",
    "check:root": "bun run format:check && bun run lint && node_modules/typescript7/bin/tsc --noEmit && bun run knip",
    "lint:package": "turbo run lint:package",
    "check": "turbo run check check:root",
    "fix": "bun run format:write && bun run lint:fix && bun run typecheck",
    "size": "turbo run size",
    "prepare": "husky",
    "test": "turbo run test test:root",
    "test:root": "vitest run",
    "test:watch": "bun run --cwd packages/animated-fluent-emojis test:watch",
    "test:coverage": "turbo run test:coverage test:coverage:root",
    "test:coverage:root": "vitest run --coverage",
    "lint:docs": "bun scripts/lint-docs.ts",
    "lint:commits": "bun scripts/lint-commits.ts",
    "assets:detect": "bun run --cwd apps/assets sync:detect",
    "assets:build": "bun run --cwd apps/assets sync:build",
    "assets:verify-live": "bun run --cwd apps/assets sync:verify-live",
    "assets:lists": "bun run --cwd apps/assets sync:lists",
    "assets:files": "bun run --cwd apps/assets sync:files",
    "i18n:status": "bun run --cwd apps/site i18n:status",
    "brand:export": "bun docs/brand/tools/export.mjs",
    "ci:local": "bun install --frozen-lockfile && bun run lint:commits && bun run lint:docs && bun run check && bun run test:coverage && bun run build && bun run size"
  }
}
