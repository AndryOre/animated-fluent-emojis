{
  "name": "animated-fluent-emojis",
  "version": "0.5.3",
  "description": "Microsoft's animated Fluent emojis as one component. They play on load or hover, rest under reduced motion and hold their space while they load.",
  "author": "Andry Orellana",
  "license": "MIT",
  "private": false,
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "keywords": [
    "react",
    "react-component",
    "emoji",
    "emojis",
    "animated",
    "animated-emoji",
    "animated-emojis",
    "fluent",
    "fluent-emoji",
    "fluent-emojis",
    "microsoft",
    "animation",
    "emoticons",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndryOre/animated-fluent-emojis.git"
  },
  "homepage": "https://github.com/AndryOre/animated-fluent-emojis#readme",
  "bugs": "https://github.com/AndryOre/animated-fluent-emojis/issues",
  "module": "./dist/animated-fluent-emojis.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/animated-fluent-emojis.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./lookup": {
      "types": "./dist/lookup/index.d.ts",
      "import": "./dist/lookup.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0 --cache --cache-strategy content",
    "lint:fix": "eslint . --fix --cache --cache-strategy content",
    "typecheck": "tsc -b",
    "knip": "knip",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,json5,md,css,yml,yaml}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,json5,md,css,yml,yaml}\" --cache",
    "lint:package": "bun run build && publint --strict && attw --pack . --profile esm-only",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run lint:package",
    "fix": "bun run format:write && bun run lint:fix && bun run typecheck",
    "size": "size-limit",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:docs": "bun scripts/lint-docs.ts",
    "lint:commits": "bun scripts/lint-commits.ts",
    "assets:detect": "bun scripts/assets/sync.ts detect",
    "assets:build": "bun scripts/assets/sync.ts build",
    "assets:verify-live": "bun scripts/assets/sync.ts verify-live",
    "assets:lists": "bun scripts/assets/sync.ts lists",
    "brand:export": "bun docs/brand/tools/export.mjs",
    "ci:local": "bun install --frozen-lockfile && bun run lint:commits && bun run lint:docs && bun run check && bun run test:coverage && bun run build && bun run size"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-react/eslint-plugin": "^5.24.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@size-limit/file": "^14.1.0",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/browser-playwright": "^5",
    "@vitest/coverage-v8": "^5",
    "axe-core": "^4.13.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^77",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "msw": "^3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "size-limit": "^14.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5",
    "vitest-browser-react": "^2.3.0",
    "yaml": "^2.9.1"
  },
  "size-limit": [
    {
      "name": "ESM bundle",
      "path": [
        "dist/animated-fluent-emojis.js",
        "dist/react.js",
        "dist/chunks/manifest-*.js"
      ],
      "limit": "4.5 kB"
    },
    {
      "name": "React bundle",
      "path": [
        "dist/react.js",
        "dist/chunks/manifest-*.js"
      ],
      "limit": "4.5 kB"
    },
    {
      "name": "Lookup bundle",
      "path": [
        "dist/lookup.js",
        "dist/chunks/manifest-*.js"
      ],
      "limit": "2.8 kB"
    },
    {
      "name": "Stylesheet",
      "path": "dist/style.css",
      "limit": "170 B"
    }
  ],
  "packageManager": "bun@1.4.2"
}
