{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':semanticCommits',
    ':semanticCommitTypeAll(chore)',
  ],

  timezone: 'UTC',
  schedule: ['before 12pm on monday'],

  // Rate limits — low noise for solo dev
  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  branchConcurrentLimit: 5,

  rangeStrategy: 'bump',

  // Wait 3 days before opening a PR — guards against supply-chain attacks on freshly published versions
  minimumReleaseAge: '3 days',

  labels: ['dependencies'],

  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
    labels: ['Priority: Critical', 'Type: Security'],
    assignees: ['AndryOre'],
  },

  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 12pm on monday'],
    automerge: true,
  },

  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.ya?ml$/'],
      matchStrings: ['npm install -g npm@(?<currentValue>\\d+\\.\\d+\\.\\d+)'],
      datasourceTemplate: 'npm',
      depNameTemplate: 'npm',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.ya?ml$/'],
      matchStrings: ['wranglerVersion: (?<currentValue>\\d+\\.\\d+\\.\\d+)'],
      datasourceTemplate: 'npm',
      depNameTemplate: 'wrangler',
    },
  ],

  packageRules: [
    {
      matchPackageNames: ['@types/node'],
      allowedVersions: '<25',
    },
    {
      matchDepTypes: ['devDependencies'],
      semanticCommitScope: 'deps-dev',
    },
    {
      matchDepTypes: ['dependencies'],
      semanticCommitScope: 'deps',
    },

    // Library: consumers rely on the broad peer ranges, so widen instead of bumping
    {
      matchDepTypes: ['peerDependencies'],
      rangeStrategy: 'widen',
    },

    {
      groupName: 'react',
      matchPackageNames: ['react', 'react-dom', '@types/react*'],
    },
    {
      groupName: 'vite',
      matchPackageNames: ['vite', '@vitejs/**', 'vite-plugin-*'],
    },
    {
      groupName: 'eslint',
      matchPackageNames: [
        'eslint',
        '@eslint/**',
        'typescript-eslint',
        'eslint-plugin-*',
        'eslint-config-*',
        '@vitest/eslint-plugin',
      ],
    },
    {
      groupName: 'vitest',
      matchPackageNames: ['vitest', '@vitest/**'],
    },
    {
      groupName: 'type definitions',
      matchPackageNames: ['@types/**'],
    },
    {
      groupName: 'github-actions',
      matchManagers: ['github-actions'],
    },

    // Automerge with a 7-day release age (stricter than global 3-day) as extra supply-chain buffer
    {
      matchDepTypes: ['devDependencies'],
      matchUpdateTypes: ['patch', 'minor'],
      automerge: true,
      automergeType: 'pr',
      minimumReleaseAge: '7 days',
    },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['patch', 'minor', 'digest', 'pin', 'pinDigest'],
      automerge: true,
      automergeType: 'pr',
      minimumReleaseAge: '7 days',
    },
  ],
}
