{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':semanticCommits',
    ':semanticCommitTypeAll(chore)',
    ':preserveSemverRanges',
    'helpers:pinGitHubActionDigests',
    'group:monorepos',
  ],

  timezone: 'UTC',
  schedule: ['before 12pm on monday'],

  // Rate limits — low noise for solo dev
  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  branchConcurrentLimit: 5,

  rangeStrategy: 'bump',
  // Main requires the PR branch to be up to date before merging
  // (strict_required_status_checks_policy in the main branch ruleset),
  // so automerge branches must be kept current, not just conflict-free
  rebaseWhen: 'behind-base-branch',

  // Wait 3 days before opening a PR — guards against supply-chain attacks on freshly published versions
  minimumReleaseAge: '3 days',

  labels: ['dependencies'],

  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
    labels: ['Priority: Critical', 'Type: Security'],
    assignees: ['AndryOre'],
  },

  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 12pm on monday'],
    automerge: true,
  },

  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.ya?ml$/'],
      matchStrings: ['npm install -g npm@(?<currentValue>\\d+\\.\\d+\\.\\d+)'],
      datasourceTemplate: 'npm',
      depNameTemplate: 'npm',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.ya?ml$/'],
      matchStrings: ['wranglerVersion: (?<currentValue>\\d+\\.\\d+\\.\\d+)'],
      datasourceTemplate: 'npm',
      depNameTemplate: 'wrangler',
    },
    // Bumping ACTIONLINT_VERSION leaves ACTIONLINT_SHA256 stale: the Renovate PR
    // fails lint-workflows until the checksum is updated by hand
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/lint-workflows\\.yml$/'],
      matchStrings: ['ACTIONLINT_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'rhysd/actionlint',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/lint-workflows\\.yml$/'],
      matchStrings: [
        'zizmorcore/zizmor-action@[^\\n]+\\n\\s+with:\\n\\s+version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'zizmorcore/zizmor',
    },
  ],

  packageRules: [
    {
      matchPackageNames: ['@types/node'],
      allowedVersions: '<25',
    },
    {
      matchDepTypes: ['devDependencies'],
      semanticCommitScope: 'deps-dev',
    },
    {
      matchDepTypes: ['dependencies'],
      semanticCommitScope: 'deps',
    },

    // Library: consumers rely on the broad peer ranges, so widen instead of bumping
    {
      matchDepTypes: ['peerDependencies'],
      rangeStrategy: 'widen',
    },

    {
      groupName: 'react',
      matchPackageNames: ['react', 'react-dom', '@types/react*'],
    },
    {
      groupName: 'vite',
      matchPackageNames: ['vite', '@vitejs/**', 'vite-plugin-*'],
    },
    {
      groupName: 'eslint',
      matchPackageNames: [
        'eslint',
        '@eslint/**',
        'typescript-eslint',
        'eslint-plugin-*',
        'eslint-config-*',
        '@vitest/eslint-plugin',
      ],
    },
    {
      groupName: 'vitest',
      matchPackageNames: ['vitest', '@vitest/**'],
    },
    {
      groupName: 'type definitions',
      matchPackageNames: ['@types/**'],
    },
    {
      groupName: 'github-actions',
      matchManagers: ['github-actions'],
    },

    // Automerge with a 7-day release age (stricter than global 3-day) as extra supply-chain buffer
    {
      matchDepTypes: ['devDependencies'],
      matchUpdateTypes: ['patch', 'minor'],
      automerge: true,
      automergeType: 'pr',
      minimumReleaseAge: '7 days',
    },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['patch', 'minor', 'digest', 'pin', 'pinDigest'],
      automerge: true,
      automergeType: 'pr',
      minimumReleaseAge: '7 days',
    },
  ],
}
