{
  "extends": ["astro/tsconfigs/strict", "../../tsconfig.base.json"],
  "compilerOptions": {
    "jsxImportSource": "react",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "playwright.visual.config.ts",
    "e2e/**/*",
    "e2e-visual/**/*",
    "src/**/*",
    "src/pages/.well-known/*"
  ],
  "exclude": ["node_modules", "dist"]
}
