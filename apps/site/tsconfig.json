{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "playwright.visual.config.ts",
    "e2e/**/*",
    "e2e-visual/**/*",
    "src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
