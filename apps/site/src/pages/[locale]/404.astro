---
import NotFoundPage from '../../components/NotFoundPage.astro'
import { localeFromSegment, LOCALES, localeSegment } from '../../i18n/locales'

export function getStaticPaths() {
  return LOCALES.filter((locale) => locale !== 'en').map((locale) => ({
    params: { locale: localeSegment(locale) },
  }))
}

const locale = localeFromSegment(Astro.params.locale)
if (!locale) throw new Error(`Unknown locale "${Astro.params.locale}"`)
---

<NotFoundPage locale={locale} />
