---
import Emoji from 'animated-fluent-emojis/astro'

import '../styles/global.css'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Animated Fluent Emojis</title>
  </head>
  <body class="grid min-h-screen place-items-center">
    <main class="flex flex-col items-center gap-4">
      <Emoji id="1f44b_wavinghand" size={96} animationIterations="infinite" />
      <h1 class="text-2xl font-semibold">Animated Fluent Emojis</h1>
    </main>
  </body>
</html>
