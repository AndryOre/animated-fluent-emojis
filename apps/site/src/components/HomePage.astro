---
import Emoji from 'animated-fluent-emojis/astro'

import { buttonVariants } from '@/components/ui/button'

import libraryPackage from '../../../../packages/animated-fluent-emojis/package.json'
import { loadPublicIndex } from '../gallery/public-index'
import {
  buildCodeBlockTabs,
  buildInstallHtml,
  pickTeaserEmojis,
} from '../home/content'
import {
  DEMO_EMOJIS,
  DEMO_PLAYS,
  INITIAL_DEMO_STATE,
  type DemoTabs,
} from '../home/demo'
import DemoPlayground from '../home/DemoPlayground'
import FaqAccordion from '../home/FaqAccordion'
import { localePath, type Locale } from '../i18n/locales'
import { getUi } from '../i18n/ui'
import Layout from '../layouts/Layout.astro'
import CodeBlock from './CodeBlock'
import InstallBlock from './InstallBlock'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { home, meta } = getUi(locale)

const galleryHref = localePath(locale, '/emojis/')
const index = await loadPublicIndex()
const snippetEmoji = index.find((emoji) => emoji.id === '1f44b_wavinghand')
if (!snippetEmoji) throw new Error('The public index has no waving hand')
const TEASER_COUNT = 12
const tabs = await buildCodeBlockTabs(snippetEmoji)
const demoEmojis = index.filter((emoji) =>
  DEMO_EMOJIS.some(({ id }) => id === emoji.id),
)
const demoTabs = Object.fromEntries(
  await Promise.all(
    DEMO_PLAYS.map(async ({ id: play }) => [
      play,
      {
        plain: await buildCodeBlockTabs(
          snippetEmoji,
          undefined,
          INITIAL_DEMO_STATE.size,
          play,
        ),
        toned: await buildCodeBlockTabs(
          snippetEmoji,
          'light',
          INITIAL_DEMO_STATE.size,
          play,
        ),
      },
    ]),
  ),
) as DemoTabs
const installHtml = await buildInstallHtml()
const teaser = pickTeaserEmojis(index, TEASER_COUNT)

const pillars = [
  { icon: '1f44b_wavinghand', ...home.pillars.alive },
  { icon: 'feather', ...home.pillars.light },
  { icon: '1f319_crescentmoon', ...home.pillars.considerate },
  { icon: 'handshake', ...home.pillars.credit },
]
const formats = [
  { name: 'GIF', description: home.noCode.formats.gif },
  { name: 'WebP', description: home.noCode.formats.webp },
  { name: 'PNG', description: home.noCode.formats.png },
]
const faq = [home.faq.chat, home.faq.speed, home.faq.motion]

const demoLabels = {
  emojiLabel: home.demo.emojiLabel,
  sizeLabel: home.demo.sizeLabel,
  toneLabel: home.demo.toneLabel,
  playsLabel: home.demo.playsLabel,
  reset: home.demo.reset,
  emojis: home.demo.emojis,
  tones: home.demo.tones,
  plays: home.demo.plays,
  code: {
    tabsLabel: home.snippets.tabsLabel,
    copy: home.snippets.copy,
    copied: home.snippets.copied,
  },
}

const wrap = 'site-container'
const section = `${wrap} py-16 md:py-24`
const eyebrow =
  'mb-3 font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground'
const heading =
  'text-[clamp(24px,4vw,36px)] leading-tight font-extrabold tracking-[-0.03em] text-balance'
const docsHref = localePath(locale, '/docs/')
const secondaryButton = buttonVariants({
  variant: 'outline',
  shape: 'pill',
  className: 'h-auto min-h-11 px-6 text-base font-bold',
})
const primaryButton = buttonVariants({
  shape: 'pill',
  className: 'h-auto min-h-11 px-6 text-base font-bold',
})
---

<Layout locale={locale} title={meta.siteName} description={meta.description}>
  <main id="main" class="flex-1">
    <section class="relative -mt-[65px]">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-0 h-[520px] [background:radial-gradient(60%_80%_at_0%_0%,color-mix(in_oklab,var(--primary)_16%,transparent),transparent_70%),radial-gradient(50%_70%_at_100%_0%,color-mix(in_oklab,var(--primary)_7%,transparent),transparent_70%)] [mask-image:linear-gradient(to_bottom,black_40%,transparent)]"
      ></div>
      <div
        class={`${wrap} relative grid grid-cols-[minmax(0,1fr)] items-center gap-12 pt-[calc(65px+56px)] pb-10 min-[860px]:grid-cols-[1fr_1.05fr]`}
      >
        <div class="flex min-w-0 flex-col items-start gap-5">
          <p class="font-mono text-xs tracking-[0.12em] text-muted-foreground uppercase">
            v{libraryPackage.version} · {home.hero.eyebrow}
          </p>
          <h1 class="text-[clamp(36px,6vw,60px)] leading-[1.02] font-extrabold tracking-[-0.04em] text-balance">
            {home.tagline}
          </h1>
          <p class="text-xl text-pretty text-muted-foreground">
            {home.hero.sub}
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={galleryHref} class={primaryButton}>
              {home.hero.browse}
            </a>
            <a href={docsHref} class={secondaryButton}>
              {home.hero.docs}
            </a>
          </div>
          <div class="flex w-full flex-col gap-3">
            <div class="w-full max-w-lg">
              <InstallBlock
                client:load
                htmlByManager={installHtml}
                labels={{
                  tabsLabel: home.hero.installLabel,
                  copy: home.hero.copy,
                  copied: home.hero.copied,
                }}
              />
            </div>
            <p class="text-sm text-muted-foreground">{home.hero.attribution}</p>
          </div>
        </div>
        <DemoPlayground
          client:idle
          emojis={demoEmojis}
          tabs={demoTabs}
          labels={demoLabels}
        />
      </div>
    </section>

    <section class={section} aria-labelledby="pillars-title">
      <div class="scroll-reveal">
        <p class={eyebrow}>{home.pillars.eyebrow}</p>
        <h2 id="pillars-title" class={`${heading} mb-8`}>
          {home.pillars.title}
        </h2>
      </div>
      <ul
        data-pillar-spotlight
        class="pillar-stagger grid list-none grid-cols-1 gap-3 p-0 min-[860px]:grid-cols-3"
      >
        {pillars.map((pillar, position) => (
          <li
            class={`scroll-reveal spotlight flex flex-col gap-2 rounded-2xl border border-border bg-card p-5 ${position === 0 ? 'min-[860px]:col-span-2 min-[860px]:row-span-2 min-[860px]:justify-between min-[860px]:p-8' : ''} ${position === 3 ? 'min-[860px]:col-span-3' : ''}`}
          >
            <Emoji
              id={pillar.icon}
              size={position === 0 ? 120 : 40}
              playOnHover={position === 0}
              autoPlay={position !== 0}
              alt=""
            />
            <div class="flex flex-col gap-1">
              <h3 class="text-lg font-extrabold text-balance">
                {pillar.title}
              </h3>
              <p class="text-pretty text-muted-foreground">{pillar.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class={section} aria-labelledby="snippets-title">
      <div class="scroll-reveal">
        <h2 id="snippets-title" class={`${heading} mb-2`}>
          {home.snippets.title}
        </h2>
        <p class="mb-6 text-pretty text-muted-foreground">
          {home.snippets.body}
        </p>
        <CodeBlock
          client:visible
          tabs={tabs}
          labels={{
            tabsLabel: home.snippets.tabsLabel,
            copy: home.snippets.copy,
            copied: home.snippets.copied,
          }}
        />
      </div>
    </section>

    <section class={section} aria-labelledby="no-code-title">
      <div class="grid items-center gap-10 min-[860px]:grid-cols-2">
        <div class="scroll-reveal flex flex-col items-start gap-4">
          <p class={eyebrow}>{home.noCode.eyebrow}</p>
          <h2 id="no-code-title" class={heading}>
            {home.noCode.title}
          </h2>
          <p class="text-pretty text-muted-foreground">{home.noCode.body}</p>
          <ul class="m-0 grid w-full list-none gap-3 p-0 min-[520px]:grid-cols-3">
            {formats.map((format) => (
              <li class="flex flex-col gap-1 rounded-xl border border-border bg-card p-4">
                <span class="font-mono text-sm font-bold">{format.name}</span>
                <span class="text-sm text-muted-foreground">
                  {format.description}
                </span>
              </li>
            ))}
          </ul>
          <a href={galleryHref} class={primaryButton}>
            {home.noCode.cta}
          </a>
        </div>
        <a
          href={galleryHref}
          aria-label={home.noCode.teaserLabel}
          class="scroll-reveal scroll-drift-scope flex min-w-0 items-center gap-4 overflow-hidden rounded-2xl border border-border bg-card px-5 py-8 [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]"
        >
          <div class="scroll-drift flex shrink-0 items-center gap-4">
            {teaser.map((emoji) => (
              <span class="shrink-0">
                <Emoji id={emoji.id} size={64} alt="" />
              </span>
            ))}
          </div>
        </a>
      </div>
    </section>

    <section class={section} aria-labelledby="faq-title">
      <div class="scroll-reveal scroll-reveal-last">
        <p class={eyebrow}>{home.faq.eyebrow}</p>
        <h2 id="faq-title" class={`${heading} mb-6`}>
          {home.faq.title}
        </h2>
        <FaqAccordion client:visible items={faq} />
      </div>
    </section>
  </main>
</Layout>

<script>
  import { attachPillarSpotlight } from '../scripts/pillar-spotlight'

  const cards = document.querySelectorAll<HTMLElement>(
    '[data-pillar-spotlight] > .spotlight',
  )
  attachPillarSpotlight(cards)
</script>
