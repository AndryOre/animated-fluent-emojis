---
import Emoji from 'animated-fluent-emojis/astro'

import type { Locale } from '../i18n/locales'
import { getUi } from '../i18n/ui'
import Layout from '../layouts/Layout.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { home } = getUi(locale)
---

<Layout locale={locale} title={home.title}>
  <main
    id="main"
    class="mx-auto flex w-full max-w-3xl flex-1 flex-col items-center justify-center gap-4 px-6 py-24 text-center"
  >
    <Emoji
      id="1f44b_wavinghand"
      size={96}
      animationIterations="infinite"
      alt=""
    />
    <h1 class="text-[40px] leading-tight font-extrabold">{home.title}</h1>
    <p class="text-muted-foreground">{home.tagline}</p>
  </main>
</Layout>
