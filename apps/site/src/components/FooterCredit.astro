---
import ExternalLink from '@lucide/astro/icons/external-link'

import type { Locale } from '../i18n/locales'
import { getUi } from '../i18n/ui'
import { AUTHOR_NAME, AUTHOR_URL, externalLinkAttributes } from '../site-links'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { common, footer } = getUi(locale)
const [before = '', after = ''] = footer.builtBy.split('{name}', 2)
const authorAttributes = externalLinkAttributes('author')
---

<p class="text-[13px] text-foreground">
  {before}
  <a
    href={AUTHOR_URL}
    {...authorAttributes}
    class="inline-flex items-center gap-1 font-semibold text-primary-text underline-offset-4 hover:underline"
  >
    {AUTHOR_NAME}
    <ExternalLink class="size-3.5" aria-hidden="true" />
    <span class="sr-only"> ({common.opensInNewTab})</span>
  </a>
  {after}
</p>
