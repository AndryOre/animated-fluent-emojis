---
import ExternalLink from '@lucide/astro/icons/external-link'

import type { Locale } from '../i18n/locales'
import { getUi } from '../i18n/ui'
import { AUTHOR_NAME, AUTHOR_URL } from '../site-links'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const [before = '', after = ''] = getUi(locale).footer.builtBy.split(
  '{name}',
  2,
)
---

<p class="text-[13px] text-foreground">
  {before}
  <a
    href={AUTHOR_URL}
    rel="author"
    class="inline-flex items-center gap-1 font-semibold text-primary-text underline-offset-4 hover:underline"
  >
    {AUTHOR_NAME}
    <ExternalLink size={16} aria-hidden="true" />
  </a>
  {after}
</p>
