---
import type { Locale } from '../i18n/locales'
import { getUi } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { header } = getUi(Astro.props.locale)
const { theme } = header
---

<button
  type="button"
  data-theme-toggle
  data-labels={JSON.stringify(theme)}
  aria-label={header.themeLabel}
  title={header.themeLabel}
  class="inline-flex h-10 min-w-10 cursor-pointer items-center justify-center gap-2 rounded-full border border-border bg-card px-3 text-sm font-medium text-foreground hover:bg-accent"
>
  <span aria-hidden="true" data-theme-icon>
    ◐
  </span>
  <span data-theme-label class="max-[860px]:sr-only">
    {theme.system}
  </span>
</button>

<script>
  import { THEME_STORAGE_KEY } from '../scripts/theme-keys'

  type Theme = 'system' | 'light' | 'dark'
  const ORDER: Theme[] = ['system', 'light', 'dark']
  const ICONS: Record<Theme, string> = {
    system: '◐',
    light: '☀',
    dark: '☾',
  }

  function readTheme(): Theme {
    try {
      const stored = localStorage.getItem(THEME_STORAGE_KEY)
      return stored === 'light' || stored === 'dark' ? stored : 'system'
    } catch {
      return 'system'
    }
  }

  function apply(theme: Theme) {
    const dark =
      theme === 'dark' ||
      (theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)
    document.documentElement.classList.toggle('dark', dark)
    document.documentElement.dataset.theme = theme
  }

  function render(button: HTMLElement, theme: Theme) {
    const labels = JSON.parse(button.dataset.labels ?? '{}') as Record<
      Theme,
      string
    >
    const icon = button.querySelector('[data-theme-icon]')
    const label = button.querySelector('[data-theme-label]')
    if (icon) icon.textContent = ICONS[theme]
    if (label) label.textContent = labels[theme]
  }

  document
    .querySelectorAll<HTMLElement>('[data-theme-toggle]')
    .forEach((button) => {
      render(button, readTheme())
      button.addEventListener('click', () => {
        const next =
          ORDER[(ORDER.indexOf(readTheme()) + 1) % ORDER.length] ?? 'system'
        try {
          if (next === 'system') localStorage.removeItem(THEME_STORAGE_KEY)
          else localStorage.setItem(THEME_STORAGE_KEY, next)
        } catch {
          document.documentElement.dataset.themeStorage = 'unavailable'
        }
        apply(next)
        render(button, next)
      })
    })

  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (readTheme() === 'system') apply('system')
  })
</script>
