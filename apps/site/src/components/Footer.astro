---
import ExternalLink from '@lucide/astro/icons/external-link'

import { localePath, type Locale } from '../i18n/locales'
import { getUi } from '../i18n/ui'
import {
  externalLinkAttributes,
  isExternalHref,
  NPM_URL,
  REPOSITORY_URL,
} from '../site-links'
import FooterCredit from './FooterCredit.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { common, footer } = getUi(locale)
const externalAttributes = externalLinkAttributes()
const links = [
  { href: localePath(locale, '/emojis/'), label: footer.links.gallery },
  { href: localePath(locale, '/docs/'), label: footer.links.docs },
  { href: REPOSITORY_URL, label: footer.links.github },
  { href: NPM_URL, label: footer.links.npm },
].map((link) => ({ ...link, external: isExternalHref(link.href) }))
---

<footer class="border-t border-border text-sm text-muted-foreground">
  <div class="site-container flex flex-col gap-3 py-5 min-[640px]:flex-row min-[640px]:flex-wrap min-[640px]:items-center min-[640px]:justify-between min-[640px]:gap-x-6">
    <p class="max-w-prose">{footer.attribution}</p>
    <nav
      aria-label={footer.navLabel}
      class="flex flex-wrap gap-x-4 gap-y-2 text-[13px] font-semibold"
    >
      {links.map((link) => (
        <a
          href={link.href}
          class={
            link.external
              ? 'inline-flex items-center gap-1 text-primary-text underline-offset-4 hover:underline'
              : 'text-primary-text underline-offset-4 hover:underline'
          }
          {...(link.external ? externalAttributes : {})}
        >
          {link.label}
          {link.external && (
            <>
              <ExternalLink class="size-3.5" aria-hidden="true" />
              <span class="sr-only"> ({common.opensInNewTab})</span>
            </>
          )}
        </a>
      ))}
    </nav>
    <FooterCredit locale={locale} />
  </div>
</footer>
