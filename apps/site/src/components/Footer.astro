---
import { localePath, type Locale } from '../i18n/locales'
import { getUi } from '../i18n/ui'
import { NPM_URL, REPOSITORY_URL } from '../site-links'
import FooterCredit from './FooterCredit.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { footer } = getUi(locale)
const links = [
  { href: localePath(locale, '/emojis/'), label: footer.links.gallery },
  { href: localePath(locale, '/docs/'), label: footer.links.docs },
  { href: REPOSITORY_URL, label: footer.links.github },
  { href: NPM_URL, label: footer.links.npm },
]
---

<footer class="border-t border-border text-sm text-muted-foreground">
  <div class="site-container flex flex-col gap-3 py-5 min-[640px]:flex-row min-[640px]:flex-wrap min-[640px]:items-center min-[640px]:justify-between min-[640px]:gap-x-6">
    <p class="max-w-prose">{footer.attribution}</p>
    <nav
      aria-label={footer.navLabel}
      class="flex flex-wrap gap-x-4 gap-y-2 text-[13px] font-semibold"
    >
      {links.map((link) => (
        <a
          href={link.href}
          class="text-primary-text underline-offset-4 hover:underline"
        >
          {link.label}
        </a>
      ))}
    </nav>
    <FooterCredit locale={locale} />
  </div>
</footer>
