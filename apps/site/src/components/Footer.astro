---
import { localePath, type Locale } from '../i18n/locales'
import { getUi } from '../i18n/ui'
import { NPM_URL, REPOSITORY_URL } from '../site-links'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { footer } = getUi(locale)
const links = [
  { href: localePath(locale, '/gallery/'), label: footer.links.gallery },
  { href: localePath(locale, '/docs/'), label: footer.links.docs },
  { href: REPOSITORY_URL, label: footer.links.github },
  { href: NPM_URL, label: footer.links.npm },
]
---

<footer class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-border p-6 text-sm text-muted-foreground">
  <p class="max-w-prose">{footer.attribution}</p>
  <nav aria-label={footer.navLabel} class="flex flex-wrap gap-x-4 gap-y-2">
    {links.map((link) => (
      <a
        href={link.href}
        class="text-primary-text underline-offset-4 hover:underline"
      >
        {link.label}
      </a>
    ))}
  </nav>
</footer>
