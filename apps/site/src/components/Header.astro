---
import logoMark from '../../../../docs/brand/logo/mark-animated.svg?url'
import { LOCALE_NAMES, localePath, LOCALES, type Locale } from '../i18n/locales'
import { getUi } from '../i18n/ui'
import { REPOSITORY_URL } from '../site-links'
import HeaderMenus from './HeaderMenus'

interface Props {
  locale: Locale
  path?: string
}

const { locale, path = '/' } = Astro.props
const { header } = getUi(locale)
const links = [
  { href: localePath(locale, '/emojis/'), label: header.nav.gallery },
  { href: localePath(locale, '/docs/'), label: header.nav.docs },
  { href: REPOSITORY_URL, label: header.nav.github },
]
const localeOptions = LOCALES.map((code) => ({
  code,
  name: LOCALE_NAMES[code],
  href: localePath(code, path),
}))
const linkClass =
  'inline-flex h-8 items-center rounded-md px-2.5 text-sm font-medium text-foreground hover:bg-muted'
---

<header class="relative z-10 border-b border-border">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-4 focus:z-50 focus:rounded-full focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
  >
    {header.skipLink}
  </a>
  <div class="site-container relative flex items-center justify-between gap-3 py-4 min-[860px]:py-3.5">
    <a
      href={localePath(locale)}
      aria-label={header.homeLabel}
      class="flex items-center gap-2.5 text-base font-extrabold tracking-tight"
    >
      <img src={logoMark} alt="" width="28" height="28" class="size-7" />
      <span class="max-[480px]:sr-only">{getUi(locale).meta.siteName}</span>
    </a>

    <nav
      aria-label={header.navLabel}
      class="hidden items-center gap-1 min-[860px]:flex"
    >
      {links.map((link) => (
        <a href={link.href} class={linkClass}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <slot name="search" />
      <HeaderMenus
        client:idle
        menuLabel={header.menu}
        navLabel={header.navLabel}
        links={links}
        languageLabel={header.languageLabel}
        themeLabel={header.themeLabel}
        themeNames={header.theme}
        repositoryLabel={header.nav.github}
        repositoryHref={REPOSITORY_URL}
        currentLocale={locale}
        locales={localeOptions}
      />
      <noscript>
        <ul class="flex flex-wrap gap-1 min-[860px]:hidden">
          {links.map((link) => (
            <li>
              <a href={link.href} class={linkClass}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <ul class="flex flex-wrap gap-1">
          {localeOptions.map((option) => (
            <li>
              <a
                href={option.href}
                lang={option.code}
                hreflang={option.code}
                aria-current={option.code === locale ? 'true' : undefined}
                class={linkClass}
              >
                {option.name}
              </a>
            </li>
          ))}
        </ul>
      </noscript>
    </div>
  </div>
</header>

<script>
  import { applyTheme, readStoredTheme } from '../scripts/theme'

  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (readStoredTheme() === 'system') applyTheme('system', false)
  })
</script>
