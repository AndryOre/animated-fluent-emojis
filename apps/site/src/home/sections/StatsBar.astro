---
import libraryPackage from '../../../../../packages/animated-fluent-emojis/package.json'
import { loadPublicIndex } from '../../gallery/public-index'
import { LOCALES, type Locale } from '../../i18n/locales'
import { getUi } from '../../i18n/ui'
import { buildHomeStats } from '../content'
import { wrap } from './styles'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { home } = getUi(locale)

const index = await loadPublicIndex()
const stats = buildHomeStats({
  emojiCount: index.length,
  localeCount: LOCALES.length,
  license: libraryPackage.license,
})
const labels = {
  emojis: home.stats.emojis,
  adapters: home.stats.adapters,
  languages: home.stats.languages,
  license: home.stats.license,
}
---

<section class={wrap} data-stats-bar>
  <ul class="scroll-reveal m-0 mt-3.5 grid list-none grid-cols-2 gap-2.5 p-0 min-[560px]:grid-cols-4">
    {stats.map((stat) => (
      <li
        class="flex flex-col gap-0.5 rounded-2xl border border-border bg-card px-4.5 py-4"
        data-stat={stat.id}
      >
        <span class="text-3xl leading-stat font-extrabold tracking-stat tabular-nums">
          {stat.value}
        </span>
        <span class="text-meta text-muted-foreground">{labels[stat.id]}</span>
      </li>
    ))}
  </ul>
</section>
