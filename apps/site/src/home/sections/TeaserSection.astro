---
import Emoji from 'animated-fluent-emojis/astro'

import { buttonVariants } from '@/components/ui/button'

import { loadAnnotations, localizeEmojis } from '../../gallery/annotations'
import { loadPublicIndex } from '../../gallery/public-index'
import { localePath, type Locale } from '../../i18n/locales'
import { getUi } from '../../i18n/ui'
import { pickTeaserEmojis } from '../content'
import { eyebrow, heading, section } from './styles'

interface Props {
  locale: Locale
}

const TEASER_EMOJI_SIZE = 46

const { locale } = Astro.props
const { home } = getUi(locale)

const galleryHref = localePath(locale, '/emojis/')
const [index, annotations] = await Promise.all([
  loadPublicIndex(),
  loadAnnotations(locale),
])
const names = new Map(
  localizeEmojis(index, annotations).map((entry) => [entry.slug, entry.name]),
)
const tiles = pickTeaserEmojis(
  index,
  Boolean(process.env.SITE_EMOJI_SLUGS),
).map(({ emoji, hue }) => ({
  id: emoji.id,
  hue,
  name: names.get(emoji.slug) ?? emoji.description,
}))
const secondaryButton = buttonVariants({
  variant: 'outline',
  className: 'h-auto min-h-11 rounded-xl px-5 text-base font-semibold',
})
---

<section class={section} aria-labelledby="teaser-title">
  <div class="flex flex-col gap-8">
    <div class="scroll-reveal flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class={eyebrow}>{home.teaser.eyebrow}</p>
        <h2 id="teaser-title" class={heading}>
          {home.teaser.title}
        </h2>
      </div>
      <a href={galleryHref} class={secondaryButton}>
        {home.teaser.cta}
      </a>
    </div>
    <ul class="scroll-reveal m-0 grid w-full list-none grid-cols-3 gap-2.5 p-0 min-[860px]:grid-cols-6">
      {tiles.map((tile) => (
        <li class="teaser-cell flex">
          <a
            href={galleryHref}
            class="teaser-tile relative isolate flex w-full flex-col items-center gap-2 overflow-hidden rounded-[18px] border border-border bg-card px-1.5 pt-[22px] pb-3.5 outline-none focus-visible:ring-2 focus-visible:ring-primary"
            style={`--glow-hue: ${tile.hue}`}
          >
            <Emoji id={tile.id} size={TEASER_EMOJI_SIZE} alt="" />
            <small class="max-w-full truncate font-mono text-[11px] lowercase text-muted-foreground">
              {tile.name}
            </small>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .teaser-tile {
    background-image: radial-gradient(
      circle at 50% 35%,
      hsl(var(--glow-hue, 60) 90% 55% / 0.38),
      transparent 66%
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    .teaser-tile {
      transition-property: transform, border-color;
      transition-duration: 300ms;
      transition-timing-function: var(--ease-out-strong);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .teaser-cell:hover .teaser-tile {
      border-color: hsl(var(--glow-hue, 60) 80% 60%);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .teaser-cell:hover .teaser-tile {
      transform: translateY(-6px) rotate(-1.5deg);
    }
  }
</style>
