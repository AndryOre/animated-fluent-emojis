---
import Emoji from 'animated-fluent-emojis/astro'

import { buttonVariants } from '@/components/ui/button'

import { loadAnnotations, localizeEmojis } from '../../gallery/annotations'
import { loadPublicIndex } from '../../gallery/public-index'
import { localePath, type Locale } from '../../i18n/locales'
import { getUi } from '../../i18n/ui'
import { pickTeaserEmojis } from '../content'
import { heading, section } from './styles'

interface Props {
  locale: Locale
}

const TEASER_EMOJI_SIZE = 64

const { locale } = Astro.props
const { home } = getUi(locale)

const galleryHref = localePath(locale, '/emojis/')
const [index, annotations] = await Promise.all([
  loadPublicIndex(),
  loadAnnotations(locale),
])
const names = new Map(
  localizeEmojis(index, annotations).map((entry) => [entry.slug, entry.name]),
)
const tiles = pickTeaserEmojis(
  index,
  Boolean(process.env.SITE_EMOJI_SLUGS),
).map(({ emoji, hue }) => ({
  id: emoji.id,
  hue,
  name: names.get(emoji.slug) ?? emoji.description,
}))
const secondaryButton = buttonVariants({
  variant: 'outline',
  className: 'h-auto min-h-11 rounded-xl px-5 text-base font-semibold',
})
---

<section class={section} aria-labelledby="teaser-title">
  <div class="flex flex-col gap-8">
    <div class="scroll-reveal flex flex-wrap items-end justify-between gap-4">
      <h2 id="teaser-title" class={heading}>
        {home.teaser.title}
      </h2>
      <a href={galleryHref} class={secondaryButton}>
        {home.teaser.cta}
      </a>
    </div>
    <ul class="scroll-reveal m-0 grid w-full list-none grid-cols-3 gap-2.5 p-0 min-[860px]:grid-cols-6">
      {tiles.map((tile) => (
        <li class="contents">
          <a
            href={galleryHref}
            class="teaser-tile relative isolate flex flex-col items-center gap-2 overflow-hidden rounded-[18px] border border-border bg-card px-1.5 pt-5 pb-3.5 outline-none focus-visible:ring-2 focus-visible:ring-primary"
            style={`--glow-hue: ${tile.hue}`}
          >
            <Emoji id={tile.id} size={TEASER_EMOJI_SIZE} alt="" />
            <small class="max-w-full truncate font-mono text-[11px] text-muted-foreground">
              {tile.name}
            </small>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .teaser-tile::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      circle closest-side,
      oklch(0.8 0.15 var(--glow-hue, 60)),
      transparent
    );
    opacity: 0.4;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .teaser-tile::before {
      transition-property: opacity, scale;
      transition-duration: 200ms;
      transition-timing-function: var(--ease-out-strong);
    }

    .teaser-tile:focus-visible::before {
      opacity: 0.85;
      scale: 1.5;
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .teaser-tile:hover::before {
      opacity: 0.85;
      scale: 1.5;
    }
  }
</style>
