---
import Emoji from 'animated-fluent-emojis/astro'

import { type Locale } from '../../i18n/locales'
import { getUi } from '../../i18n/ui'
import FaqAccordion from '../FaqAccordion'
import { eyebrow, heading, section } from './styles'

interface Props {
  locale: Locale
}

const MASCOT_SIZE = 250

const { locale } = Astro.props
const { home } = getUi(locale)

const faq = [
  { id: 'chat', emojiId: 'speechbubble', ...home.faq.chat },
  { id: 'speed', emojiId: '26a1_highvoltagesign', ...home.faq.speed },
  { id: 'motion', emojiId: '1f319_crescentmoon', ...home.faq.motion },
]
---

<section class={section} aria-labelledby="faq-title">
  <div class="faq-scope scroll-reveal scroll-reveal-last grid items-stretch gap-10 split:grid-cols-faq">
    <div class="min-w-0">
      <p class={eyebrow}>{home.faq.eyebrow}</p>
      <h2 id="faq-title" class={`${heading} mb-6`}>
        {home.faq.title}
      </h2>
      <FaqAccordion client:visible items={faq} />
    </div>
    <div
      aria-hidden="true"
      data-faq-mascots
      class="relative hidden min-h-75 min-w-0 overflow-hidden rounded-22 border border-border bg-card split:block bg-glow-faq"
    >
      <span class="absolute top-4 left-4 font-mono text-caption leading-4 text-muted-foreground">
        {home.faq.mascotLabel}
      </span>
      {faq.map((entry) => (
        <span
          data-faq-mascot={entry.id}
          class="absolute -right-9 -bottom-11 block -rotate-8"
          style={`width: ${MASCOT_SIZE}px; height: ${MASCOT_SIZE}px`}
        >
          <Emoji id={entry.emojiId} size={MASCOT_SIZE} alt="" />
        </span>
      ))}
    </div>
  </div>
</section>
