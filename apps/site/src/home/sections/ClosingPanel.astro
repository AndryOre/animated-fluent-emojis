---
import Emoji from 'animated-fluent-emojis/astro'

import { buttonVariants } from '@/components/ui/button'

import { localePath, type Locale } from '../../i18n/locales'
import { getUi } from '../../i18n/ui'
import { externalLinkAttributes, REPOSITORY_URL } from '../../site-links'
import { section } from './styles'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { home, common } = getUi(locale)

const docsHref = localePath(locale, '/docs/')

const decorations = [
  {
    id: '1f389_partypopper',
    placement: 'top-5 left-pct-4',
    size: 'size-26',
    tilt: '-rotate-10',
    delay: '0s',
  },
  {
    id: 'fire',
    placement: 'bottom-3.5 left-pct-19',
    size: 'size-14.5',
    tilt: 'rotate-0',
    delay: '1.1s',
  },
  {
    id: 'launch',
    placement: 'top-4 right-pct-4',
    size: 'size-27.5',
    tilt: 'rotate-10',
    delay: '0.5s',
  },
  {
    id: 'heartgreen',
    placement: 'bottom-4.5 right-pct-18',
    size: 'size-15.5',
    tilt: 'rotate-0',
    delay: '1.7s',
  },
]

const primaryButton = buttonVariants({
  className:
    'h-auto min-h-11 rounded-xl bg-foreground px-5 text-base font-semibold text-background hover:bg-foreground/90',
})
const secondaryButton = buttonVariants({
  variant: 'outline',
  className: 'h-auto min-h-11 rounded-xl px-5 text-base font-semibold',
})
---

<section class={section} aria-labelledby="closing-title">
  <div class="dock-end scroll-reveal scroll-reveal-last relative isolate overflow-hidden rounded-28 border border-border bg-card px-6 py-16 text-center md:min-h-85 md:py-18">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 bg-glow-closing"
    ></div>
    <div aria-hidden="true" class="pointer-events-none">
      {decorations.map((decoration) => (
        <span
          class={`emoji-float absolute hidden split:block ${decoration.size} ${decoration.placement} ${decoration.tilt}`}
          style={`--float-delay: ${decoration.delay}`}
        >
          <Emoji id={decoration.id} size="100%" alt="" />
        </span>
      ))}
    </div>
    <div class="relative mx-auto flex max-w-xl flex-col items-center gap-5">
      <h2
        id="closing-title"
        class="text-fluid-closing leading-tight font-extrabold tracking-heading text-balance"
      >
        {home.closing.titleLead}{' '}
        <span class="text-primary">{home.closing.titleAccent}</span>
      </h2>
      <p class="text-lg text-pretty text-muted-foreground">
        {home.closing.body}
      </p>
      <div class="flex flex-wrap justify-center gap-2.5">
        <a href={docsHref} class={primaryButton}>
          {home.hero.ctaDocs}
        </a>
        <a
          href={REPOSITORY_URL}
          class={secondaryButton}
          data-closing-github
          {...externalLinkAttributes()}
        >
          {home.closing.cta}
          <span class="sr-only"> ({common.opensInNewTab})</span>
        </a>
      </div>
    </div>
  </div>
</section>
