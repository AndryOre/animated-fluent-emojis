---
import Emoji from 'animated-fluent-emojis/astro'

import { buttonVariants } from '@/components/ui/button'

import { localePath, type Locale } from '../../i18n/locales'
import { getUi } from '../../i18n/ui'
import { externalLinkAttributes, REPOSITORY_URL } from '../../site-links'
import { section } from './styles'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { home, common } = getUi(locale)

const docsHref = localePath(locale, '/docs/')

const decorations = [
  {
    id: '1f389_partypopper',
    placement: 'top-5 left-[4%]',
    size: 'size-[104px]',
    tilt: '-rotate-[10deg]',
    delay: '0s',
  },
  {
    id: 'fire',
    placement: 'bottom-3.5 left-[19%]',
    size: 'size-[58px]',
    tilt: 'rotate-0',
    delay: '1.1s',
  },
  {
    id: 'launch',
    placement: 'top-4 right-[4%]',
    size: 'size-[110px]',
    tilt: 'rotate-[10deg]',
    delay: '0.5s',
  },
  {
    id: 'heartgreen',
    placement: 'bottom-[18px] right-[18%]',
    size: 'size-[62px]',
    tilt: 'rotate-0',
    delay: '1.7s',
  },
]

const primaryButton = buttonVariants({
  className:
    'h-auto min-h-11 rounded-xl bg-foreground px-5 text-base font-semibold text-background hover:bg-foreground/90',
})
const secondaryButton = buttonVariants({
  variant: 'outline',
  className: 'h-auto min-h-11 rounded-xl px-5 text-base font-semibold',
})
---

<section class={section} aria-labelledby="closing-title">
  <div class="dock-end scroll-reveal scroll-reveal-last relative isolate overflow-hidden rounded-[28px] border border-border bg-card px-6 py-16 text-center md:min-h-[340px] md:py-[72px]">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 [background:radial-gradient(60%_90%_at_50%_100%,color-mix(in_oklab,var(--primary)_18%,transparent),transparent_70%)]"
    ></div>
    <div aria-hidden="true" class="pointer-events-none">
      {decorations.map((decoration) => (
        <span
          class={`emoji-float absolute hidden min-[860px]:block ${decoration.size} ${decoration.placement} ${decoration.tilt}`}
          style={`--float-delay: ${decoration.delay}`}
        >
          <Emoji id={decoration.id} size="100%" alt="" />
        </span>
      ))}
    </div>
    <div class="relative mx-auto flex max-w-xl flex-col items-center gap-5">
      <h2
        id="closing-title"
        class="text-[clamp(28px,5vw,44px)] leading-tight font-extrabold tracking-[-0.03em] text-balance"
      >
        {home.closing.titleLead}{' '}
        <span class="text-primary">{home.closing.titleAccent}</span>
      </h2>
      <p class="text-lg text-pretty text-muted-foreground">
        {home.closing.body}
      </p>
      <div class="flex flex-wrap justify-center gap-2.5">
        <a href={docsHref} class={primaryButton}>
          {home.hero.ctaDocs}
        </a>
        <a
          href={REPOSITORY_URL}
          class={secondaryButton}
          data-closing-github
          {...externalLinkAttributes()}
        >
          {home.closing.cta}
          <span class="sr-only"> ({common.opensInNewTab})</span>
        </a>
      </div>
    </div>
  </div>
</section>
