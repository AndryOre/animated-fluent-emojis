---
import Emoji from 'animated-fluent-emojis/astro'

import { buttonVariants } from '@/components/ui/button'

import InstallBlock from '../../components/InstallBlock'
import { loadPublicIndex } from '../../gallery/public-index'
import { localePath, type Locale } from '../../i18n/locales'
import { getUi } from '../../i18n/ui'
import { buildInstallHtml } from '../content'
import { wrap } from './styles'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { home } = getUi(locale)

const galleryHref = localePath(locale, '/emojis/')
const docsHref = localePath(locale, '/docs/')
const installHtml = await buildInstallHtml()
const index = await loadPublicIndex()

const decorations = [
  {
    id: '1f44b_wavinghand',
    placement: 'top-[6%] left-[-2%]',
    tilt: '-rotate-12',
    playOnHover: true,
  },
  {
    id: '2728_sparkles',
    placement: 'top-[2%] right-[-2%]',
    tilt: 'rotate-12',
    playOnHover: false,
  },
  {
    id: 'fire',
    placement: 'bottom-[16%] left-[2%]',
    tilt: 'rotate-6',
    playOnHover: false,
  },
  {
    id: 'launch',
    placement: 'bottom-[12%] right-[1%]',
    tilt: '-rotate-6',
    playOnHover: false,
  },
].filter((decoration) => index.some((emoji) => emoji.id === decoration.id))

const mobileDecorations = decorations.filter((decoration) =>
  ['1f44b_wavinghand', '2728_sparkles'].includes(decoration.id),
)

const readyChips = [
  { id: 'react', label: home.hero.ready.react },
  { id: 'vue', label: home.hero.ready.vue },
  { id: 'svelte', label: home.hero.ready.svelte },
  { id: 'astro', label: home.hero.ready.astro },
  { id: 'html', label: home.hero.ready.html },
]

const secondaryButton = buttonVariants({
  variant: 'outline',
  shape: 'pill',
  className: 'h-auto min-h-11 px-6 text-base font-bold',
})
const primaryButton = buttonVariants({
  shape: 'pill',
  className: 'h-auto min-h-11 px-6 text-base font-bold',
})
---

<section class="relative -mt-[65px] overflow-x-clip">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-[520px] [background:radial-gradient(60%_80%_at_50%_0%,color-mix(in_oklab,var(--primary)_16%,transparent),transparent_70%)] [mask-image:linear-gradient(to_bottom,black_40%,transparent)]"
  ></div>
  <div
    class={`${wrap} relative flex flex-col items-center pt-[calc(65px+40px)] pb-16 text-center md:pb-24 min-[860px]:pt-[calc(65px+72px)]`}
  >
    <div
      data-hero-emojis
      class="hero-demo-enter pointer-events-none mb-6 flex justify-center gap-6 min-[860px]:hidden"
    >
      {mobileDecorations.map((decoration) => (
        <span class={`pointer-events-auto block ${decoration.tilt}`}>
          <Emoji
            id={decoration.id}
            size={56}
            alt=""
            playOnHover={decoration.playOnHover}
          />
        </span>
      ))}
    </div>
    <div
      data-hero-emojis
      class="hero-demo-enter pointer-events-none absolute inset-0 hidden min-[860px]:block"
    >
      {decorations.map((decoration) => (
        <span
          class={`pointer-events-auto absolute size-[150px] ${decoration.tilt} ${decoration.placement}`}
        >
          <Emoji
            id={decoration.id}
            size="100%"
            alt=""
            playOnHover={decoration.playOnHover}
          />
        </span>
      ))}
    </div>
    <div class="relative flex min-w-0 max-w-3xl flex-col items-center gap-5">
      <p
        class="hero-enter inline-flex items-center rounded-full border border-border bg-card px-4 py-1.5 font-mono text-xs tracking-[0.08em] text-muted-foreground uppercase"
        style="--enter-index: 0"
      >
        {home.hero.badge}
      </p>
      <h1 class="text-[clamp(36px,6vw,60px)] leading-[1.02] font-extrabold tracking-[-0.04em] text-balance">
        {home.hero.titleLead}
        <span class="text-primary">{home.hero.titleAccent}</span>
      </h1>
      <p
        class="hero-enter max-w-2xl text-lg text-pretty text-muted-foreground md:text-xl"
        style="--enter-index: 1"
      >
        {home.hero.subtitle}
      </p>
      <div
        class="hero-enter flex flex-wrap justify-center gap-3"
        style="--enter-index: 2"
      >
        <a href={galleryHref} class={primaryButton}>
          {home.hero.ctaGallery}
        </a>
        <a href={docsHref} class={secondaryButton}>
          {home.hero.ctaDocs}
        </a>
      </div>
      <div
        class="hero-enter flex w-full flex-col items-center gap-4"
        style="--enter-index: 3"
      >
        <div class="w-full max-w-lg text-left">
          <InstallBlock
            client:load
            htmlByManager={installHtml}
            labels={{
              tabsLabel: home.hero.installLabel,
              copy: home.hero.copy,
              copied: home.hero.copied,
            }}
          />
        </div>
        <ul
          class="m-0 flex list-none flex-wrap justify-center gap-2 p-0"
          data-hero-ready
        >
          {readyChips.map((chip) => (
            <li
              class="rounded-full border border-border bg-card px-3 py-1 text-sm font-semibold text-muted-foreground"
              data-ready-chip={chip.id}
            >
              {chip.label}
            </li>
          ))}
        </ul>
        <p class="text-sm text-muted-foreground">{home.hero.attribution}</p>
      </div>
    </div>
  </div>
</section>
