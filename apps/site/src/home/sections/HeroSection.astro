---
import Emoji from 'animated-fluent-emojis/astro'

import { buttonVariants } from '@/components/ui/button'

import InstallBlock from '../../components/InstallBlock'
import { loadPublicIndex } from '../../gallery/public-index'
import { localePath, type Locale } from '../../i18n/locales'
import { getUi } from '../../i18n/ui'
import { buildInstallHtml } from '../content'
import { wrap } from './styles'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { home } = getUi(locale)

const galleryHref = localePath(locale, '/emojis/')
const docsHref = localePath(locale, '/docs/')
const installHtml = await buildInstallHtml()
const index = await loadPublicIndex()

const decorations = [
  {
    id: '1f44b_wavinghand',
    placement: 'top-[92px] left-[-34px]',
    size: 'size-[170px]',
    tilt: '-rotate-12',
    delay: '0s',
    playOnHover: true,
  },
  {
    id: 'launch',
    placement: 'top-[34px] left-[17%]',
    size: 'size-[92px]',
    tilt: 'rotate-6',
    delay: '1s',
    playOnHover: false,
  },
  {
    id: 'stareyes',
    placement: 'top-[14px] left-[44%]',
    size: 'size-[132px]',
    tilt: 'rotate-0',
    delay: '0.4s',
    playOnHover: false,
  },
  {
    id: '1f389_partypopper',
    placement: 'top-[38px] right-[17%]',
    size: 'size-[96px]',
    tilt: '-rotate-6',
    delay: '1.6s',
    playOnHover: false,
  },
  {
    id: 'fire',
    placement: 'top-[110px] right-[-36px]',
    size: 'size-[170px]',
    tilt: 'rotate-[10deg]',
    delay: '0.8s',
    playOnHover: false,
  },
].filter((decoration) => index.some((emoji) => emoji.id === decoration.id))

const mobileDecorations = decorations.filter((decoration) =>
  ['1f44b_wavinghand', 'launch'].includes(decoration.id),
)

const readyChips = [
  { id: 'react', label: home.hero.ready.react },
  { id: 'vue', label: home.hero.ready.vue },
  { id: 'svelte', label: home.hero.ready.svelte },
  { id: 'astro', label: home.hero.ready.astro },
  { id: 'html', label: home.hero.ready.html },
]

const secondaryButton = buttonVariants({
  variant: 'outline',
  className: 'h-auto min-h-11 rounded-xl px-5 text-base font-semibold',
})
const primaryButton = buttonVariants({
  className:
    'h-auto min-h-11 rounded-xl bg-foreground px-5 text-base font-semibold text-background hover:bg-foreground/90',
})
---

<section class="dock-hero relative pt-3">
  <div class={wrap}>
    <div class="relative isolate flex flex-col items-center overflow-hidden min-[860px]:justify-end rounded-[28px] border border-border bg-card px-4 pt-12 pb-12 text-center min-[860px]:min-h-[560px] min-[860px]:pt-[170px] [background-image:radial-gradient(120%_90%_at_50%_0%,color-mix(in_oklab,var(--primary)_18%,transparent),transparent_70%)]">
      <div class="hero-demo-enter pointer-events-none mb-6 min-[860px]:absolute min-[860px]:inset-0 min-[860px]:mb-0">
        <div
          data-hero-emojis
          class="flex justify-center gap-6 min-[860px]:hidden"
        >
          {mobileDecorations.map((decoration) => (
            <span class={`pointer-events-auto block ${decoration.tilt}`}>
              <Emoji
                id={decoration.id}
                size={56}
                alt=""
                playOnHover={decoration.playOnHover}
              />
            </span>
          ))}
        </div>
        <div data-hero-emojis class="absolute inset-0 hidden min-[860px]:block">
          {decorations.map((decoration) => (
            <span
              class={`emoji-float pointer-events-auto absolute ${decoration.size} ${decoration.tilt} ${decoration.placement}`}
              style={`--float-delay: ${decoration.delay}`}
            >
              <Emoji
                id={decoration.id}
                size="100%"
                alt=""
                playOnHover={decoration.playOnHover}
              />
            </span>
          ))}
        </div>
      </div>
      <div class="relative flex min-w-0 max-w-3xl flex-col items-center gap-5">
        <p
          class="hero-enter inline-flex items-center rounded-full border border-border bg-card px-4 py-1.5 font-mono text-xs tracking-[0.08em] text-muted-foreground uppercase"
          style="--enter-index: 0"
        >
          {home.hero.badge}
        </p>
        <h1 class="text-[clamp(38px,7.4vw,84px)] leading-[0.98] font-extrabold tracking-[-0.04em] text-balance">
          {home.hero.titleLead}{' '}
          <span class="block text-primary">{home.hero.titleAccent}</span>
        </h1>
        <p
          class="hero-enter max-w-2xl text-lg text-pretty text-muted-foreground md:text-xl"
          style="--enter-index: 1"
        >
          {home.hero.subtitle}
        </p>
        <div
          class="hero-enter flex flex-wrap justify-center gap-3"
          style="--enter-index: 2"
        >
          <a href={docsHref} class={primaryButton}>
            {home.hero.ctaDocs}
          </a>
          <a href={galleryHref} class={secondaryButton}>
            {home.hero.ctaGallery}
          </a>
        </div>
        <div
          class="hero-enter flex w-full flex-col items-center gap-4"
          style="--enter-index: 3"
        >
          <div class="w-full max-w-lg text-left">
            <InstallBlock
              client:load
              htmlByManager={installHtml}
              labels={{
                tabsLabel: home.hero.installLabel,
                copy: home.hero.copy,
                copied: home.hero.copied,
              }}
            />
          </div>
          <ul
            class="m-0 flex list-none flex-wrap justify-center gap-2 p-0"
            data-hero-ready
          >
            {readyChips.map((chip) => (
              <li
                class="rounded-full border border-border bg-card px-3 py-1 text-sm font-semibold text-muted-foreground"
                data-ready-chip={chip.id}
              >
                {chip.label}
              </li>
            ))}
          </ul>
          <p class="text-sm text-muted-foreground">{home.hero.attribution}</p>
        </div>
      </div>
    </div>
  </div>
</section>
