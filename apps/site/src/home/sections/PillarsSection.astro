---
import Emoji from 'animated-fluent-emojis/astro'

import { type Locale } from '../../i18n/locales'
import { getUi } from '../../i18n/ui'
import { eyebrow, heading, section } from './styles'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { home } = getUi(locale)

const wall = [
  '1f603_grinningfacewithbigeyes',
  'happyface',
  'grinningfacewithsmilingeyes',
  '1f601_beamingfacewithsmilingeyes',
  'laugh',
  'sweatgrinning',
  'rofl',
  '1f44b_wavinghand',
]
const wallPlayingFirst = 1
const wallPlayingSecond = 7

const cardClass =
  'scroll-reveal spotlight flex flex-col gap-4 rounded-2xl border border-border bg-card p-5'
const stageClass =
  'bento-stage relative flex items-center justify-center overflow-hidden rounded-xl border border-border bg-background/60'
const cursorMarkup =
  'fake-cursor bento-cursor absolute top-0 left-0 size-4 text-foreground'
---

<section class={section} aria-labelledby="pillars-title">
  <div class="scroll-reveal">
    <p class={eyebrow}>{home.bento.eyebrow}</p>
    <h2 id="pillars-title" class={`${heading} mb-8`}>
      {home.bento.title}
    </h2>
  </div>
  <ul
    data-pillar-spotlight
    class="pillar-stagger grid list-none grid-cols-1 gap-3 p-0 min-[860px]:grid-cols-3"
  >
    <li class={`${cardClass} min-[860px]:col-span-2`}>
      <div class={stageClass} style="--stage-base: 168" aria-hidden="true">
        <div class="relative grid h-[108px] w-[228px] grid-cols-4 gap-3">
          {wall.map((id, position) => (
            <span
              class={`bento-cell relative block size-12 ${position === wallPlayingFirst ? 'fake-cursor-target' : ''}`}
            >
              <span class="absolute inset-1 block">
                <Emoji id={id} size={40} autoPlay={false} alt="" />
                {position === wallPlayingFirst && (
                  <Emoji
                    id={id}
                    size={40}
                    animationIterations="infinite"
                    alt=""
                    class="bento-play-first absolute inset-0"
                  />
                )}
                {position === wallPlayingSecond && (
                  <Emoji
                    id={id}
                    size={40}
                    animationIterations="infinite"
                    alt=""
                    class="bento-play-second absolute inset-0"
                  />
                )}
              </span>
            </span>
          ))}
          <span
            class={cursorMarkup}
            style="--cursor-x0: 120px; --cursor-y0: 56px; --cursor-x1: 80px; --cursor-y1: 20px; --cursor-x2: 200px; --cursor-y2: 80px"
          >
            <svg viewBox="0 0 16 16" class="size-full" fill="currentColor">
              <path
                d="M2 1.5v11l3-2.8 2 4.3 2-.9-2-4.2h4.2z"
                class="stroke-background"
                stroke-width="1"
                stroke-linejoin="round"
              ></path>
            </svg>
          </span>
        </div>
      </div>
      <div class="flex flex-col gap-1">
        <h3 class="text-lg font-extrabold text-balance">
          {home.bento.alive.title}
        </h3>
        <p class="text-pretty text-muted-foreground">{home.bento.alive.body}</p>
      </div>
    </li>

    <li class={cardClass}>
      <div class={`${stageClass} flex-col gap-3`} style="--stage-base: 168">
        <span
          class="relative block size-14 rounded-xl border border-dashed border-border"
          aria-hidden="true"
        >
          <span class="bento-skeleton absolute inset-0 block rounded-xl bg-muted"></span>
          <span class="bento-loaded absolute inset-2 block">
            <Emoji id="feather" size={40} alt="" />
          </span>
        </span>
        <span class="font-mono text-xs text-muted-foreground">
          {home.bento.layoutShift}
        </span>
      </div>
      <div class="flex flex-col gap-1">
        <h3 class="text-lg font-extrabold text-balance">
          {home.bento.light.title}
        </h3>
        <p class="text-pretty text-muted-foreground">{home.bento.light.body}</p>
      </div>
    </li>

    <li class={cardClass}>
      <div class={stageClass} style="--stage-base: 168" aria-hidden="true">
        <div class="relative h-[72px] w-[220px]">
          <span class="absolute top-0 left-0 block size-10">
            <Emoji id="1f319_crescentmoon" size={40} autoPlay={false} alt="" />
            <Emoji
              id="1f319_crescentmoon"
              size={40}
              animationIterations="infinite"
              alt=""
              class="bento-motion-on absolute inset-0"
            />
          </span>
          <span class="bento-switch fake-cursor-target absolute top-[7px] left-[176px] block h-[26px] w-11 rounded-full border border-border bg-muted">
            <span class="bento-switch-track absolute inset-0 block rounded-full bg-primary"></span>
            <span class="bento-switch-thumb absolute top-[3px] left-[3px] block size-5 rounded-full bg-background shadow-sm"></span>
          </span>
          <span class="absolute top-[52px] left-0 grid w-full font-mono text-xs text-muted-foreground">
            <span class="bento-label-off col-start-1 row-start-1">
              {home.bento.reduceMotion.off}
            </span>
            <span class="bento-label-on col-start-1 row-start-1">
              {home.bento.reduceMotion.on}
            </span>
          </span>
          <span
            class={cursorMarkup}
            style="--cursor-x0: 120px; --cursor-y0: 52px; --cursor-x1: 192px; --cursor-y1: 16px; --cursor-x2: 140px; --cursor-y2: 58px"
          >
            <svg viewBox="0 0 16 16" class="size-full" fill="currentColor">
              <path
                d="M2 1.5v11l3-2.8 2 4.3 2-.9-2-4.2h4.2z"
                class="stroke-background"
                stroke-width="1"
                stroke-linejoin="round"
              ></path>
            </svg>
          </span>
        </div>
      </div>
      <div class="flex flex-col gap-1">
        <h3 class="text-lg font-extrabold text-balance">
          {home.bento.considerate.title}
        </h3>
        <p class="text-pretty text-muted-foreground">
          {home.bento.considerate.body}
        </p>
      </div>
    </li>

    <li class={`${cardClass} min-[860px]:col-span-2`}>
      <div
        class={`${stageClass} grid grid-cols-2 divide-x divide-border`}
        style="--stage-base: 168"
      >
        <span class="flex h-full flex-col items-center justify-center gap-1 px-3 text-center">
          <span class="font-mono text-xs text-muted-foreground">
            {home.bento.artwork.label}
          </span>
          <span class="text-sm font-semibold text-balance">
            {home.bento.artwork.value}
          </span>
        </span>
        <span class="flex h-full flex-col items-center justify-center gap-1 px-3 text-center">
          <span class="font-mono text-xs text-muted-foreground">
            {home.bento.code.label}
          </span>
          <span class="text-sm font-semibold text-balance">
            {home.bento.code.value}
          </span>
        </span>
      </div>
      <div class="flex flex-col gap-1">
        <h3 class="text-lg font-extrabold text-balance">
          {home.bento.credit.title}
        </h3>
        <p class="text-pretty text-muted-foreground">
          {home.bento.credit.body}
        </p>
      </div>
    </li>
  </ul>
</section>

<style is:global>
  .bento-stage {
    height: calc(var(--stage-base) * 0.8 * 1px);
  }

  @media (min-width: 860px) {
    .bento-stage {
      height: calc(var(--stage-base) * 1px);
    }
  }

  .bento-play-first,
  .bento-play-second,
  .bento-motion-on,
  .bento-skeleton,
  .bento-label-off {
    opacity: 0;
  }

  .bento-loaded,
  .bento-label-on,
  .bento-switch-track {
    opacity: 1;
  }

  .bento-switch-thumb {
    translate: 18px 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-cursor {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .bento-play-first {
      animation-name: bento-play-first;
    }

    .bento-play-second {
      animation-name: bento-play-second;
    }

    .bento-skeleton {
      animation-name: bento-skeleton;
    }

    .bento-loaded {
      animation-name: bento-loaded;
      transform-origin: center;
    }

    .bento-motion-on {
      animation-name: bento-motion-on;
    }

    .bento-label-off {
      animation-name: bento-label-off;
    }

    .bento-label-on {
      animation-name: bento-label-on;
    }

    .bento-switch-track {
      animation-name: bento-switch-track;
    }

    .bento-switch-thumb {
      translate: 0 0;
      animation-name: bento-switch-thumb;
    }

    .bento-play-first,
    .bento-play-second,
    .bento-skeleton,
    .bento-loaded,
    .bento-motion-on,
    .bento-label-off,
    .bento-label-on,
    .bento-switch-track,
    .bento-switch-thumb {
      animation-duration: 6s;
      animation-timing-function: var(--ease-in-out-strong);
      animation-iteration-count: infinite;
      animation-fill-mode: both;
    }

    .bento-skeleton,
    .bento-loaded {
      animation-duration: 5s;
    }
  }

  @keyframes bento-play-first {
    0%,
    24%,
    62%,
    100% {
      opacity: 0;
    }
    30%,
    56% {
      opacity: 1;
    }
  }

  @keyframes bento-play-second {
    0%,
    64%,
    100% {
      opacity: 0;
    }
    70%,
    94% {
      opacity: 1;
    }
  }

  @keyframes bento-skeleton {
    0%,
    30% {
      opacity: 1;
    }
    40%,
    90% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes bento-loaded {
    0%,
    30% {
      opacity: 0;
      transform: scale(0.92);
    }
    40%,
    90% {
      opacity: 1;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(0.92);
    }
  }

  @keyframes bento-motion-on {
    0%,
    40% {
      opacity: 1;
    }
    46%,
    96% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes bento-label-off {
    0%,
    40% {
      opacity: 1;
    }
    46%,
    96% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes bento-label-on {
    0%,
    40% {
      opacity: 0;
    }
    46%,
    96% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes bento-switch-track {
    0%,
    40% {
      opacity: 0;
    }
    46%,
    96% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes bento-switch-thumb {
    0%,
    40% {
      translate: 0 0;
    }
    46%,
    96% {
      translate: 18px 0;
    }
    100% {
      translate: 0 0;
    }
  }
</style>

<script>
  import { attachPillarSpotlight } from '../../scripts/pillar-spotlight'

  const cards = document.querySelectorAll<HTMLElement>(
    '[data-pillar-spotlight] > .spotlight',
  )
  attachPillarSpotlight(cards)
</script>
