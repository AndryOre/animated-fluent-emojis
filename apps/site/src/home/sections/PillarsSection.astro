---
import Emoji from 'animated-fluent-emojis/astro'

import { type Locale } from '../../i18n/locales'
import { getUi } from '../../i18n/ui'
import { eyebrow, heading, section } from './styles'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { home } = getUi(locale)

const wall = [
  '1f603_grinningfacewithbigeyes',
  'happyface',
  'grinningfacewithsmilingeyes',
  '1f601_beamingfacewithsmilingeyes',
  'laugh',
  'sweatgrinning',
  'rofl',
  '1f44b_wavinghand',
  'smile',
  'wink',
  'stareyes',
  'fire',
  'heart',
  'star',
  '1f4a7_droplet',
  '1f33f_herb',
  '1f52e_crystalball',
  '1f389_partypopper',
]
const wallColumns = 6
const wallPlayingFirst = 3
const wallPlayingSecond = 8
const wakeLastColumn = 3

const wakeDelay = (position: number) => {
  const column = position % wallColumns
  const row = Math.floor(position / wallColumns)
  return column <= wakeLastColumn
    ? `${(0.5 + column * 0.45 + row * 0.15).toFixed(2)}s`
    : undefined
}

const cardClass =
  'scroll-reveal spotlight flex flex-col gap-4 rounded-2xl border border-border bg-card p-5 transition-colors duration-250 ease-(--ease-out-strong) [@media(hover:hover)_and_(pointer:fine)]:hover:border-[color-mix(in_oklab,var(--primary)_45%,var(--border))]'
const stageClass =
  'bento-stage relative flex items-center justify-center overflow-hidden rounded-xl border border-border bg-background/60'
const cursorMarkup =
  'fake-cursor bento-cursor absolute top-0 left-0 size-4 text-foreground'
---

<section class={section} aria-labelledby="pillars-title">
  <div class="scroll-reveal">
    <p class={eyebrow}>{home.bento.eyebrow}</p>
    <h2 id="pillars-title" class={`${heading} mb-8`}>
      {home.bento.title}
    </h2>
  </div>
  <ul
    data-pillar-spotlight
    class="pillar-stagger grid list-none grid-cols-1 gap-3 p-0 min-[860px]:grid-cols-[1.6fr_1fr]"
  >
    <li class={`${cardClass} min-[860px]:row-span-2`}>
      <div class="flex flex-col gap-1">
        <h3 class="text-lg font-extrabold text-balance">
          {home.bento.alive.title}
        </h3>
        <p class="text-pretty text-muted-foreground">{home.bento.alive.body}</p>
      </div>
      <div
        class={`${stageClass} min-[860px]:flex-1`}
        style="--stage-base: 168"
        aria-hidden="true"
      >
        <div class="relative grid h-[248px] w-[506px] grid-cols-6 gap-2.5 max-[859px]:[zoom:0.55]">
          {wall.map((id, position) => (
            <span
              class="bento-cell relative block size-[76px] rounded-[18px] border border-border bg-card"
              data-wake={wakeDelay(position) ? '' : undefined}
              style={
                wakeDelay(position)
                  ? { '--wake-delay': wakeDelay(position) }
                  : undefined
              }
            >
              <span
                class={`absolute inset-0 grid place-items-center ${position === wallPlayingFirst ? 'fake-cursor-target' : ''}`}
              >
                <span class="relative block size-[62px]">
                  <Emoji id={id} size={62} autoPlay={false} alt="" />
                  {position === wallPlayingFirst && (
                    <Emoji
                      id={id}
                      size={62}
                      animationIterations="infinite"
                      alt=""
                      class="bento-play-first absolute inset-0"
                    />
                  )}
                  {position === wallPlayingSecond && (
                    <Emoji
                      id={id}
                      size={62}
                      animationIterations="infinite"
                      alt=""
                      class="bento-play-second absolute inset-0"
                    />
                  )}
                </span>
              </span>
            </span>
          ))}
          <span
            class={cursorMarkup}
            style="--cursor-x0: 4px; --cursor-y0: 224px; --cursor-x1: 292px; --cursor-y1: 34px; --cursor-x2: 206px; --cursor-y2: 120px"
          >
            <svg viewBox="0 0 16 16" class="size-full" fill="currentColor">
              <path
                d="M2 1.5v11l3-2.8 2 4.3 2-.9-2-4.2h4.2z"
                class="stroke-background"
                stroke-width="1"
                stroke-linejoin="round"
              ></path>
            </svg>
          </span>
        </div>
      </div>
    </li>

    <li class={cardClass}>
      <div class="flex flex-col gap-1">
        <h3 class="text-lg font-extrabold text-balance">
          {home.bento.light.title}
        </h3>
        <p class="text-pretty text-muted-foreground">{home.bento.light.body}</p>
      </div>
      <div class={`${stageClass} flex-col gap-3`} style="--stage-base: 168">
        <span
          class="relative block size-14 rounded-xl border border-dashed border-border"
          aria-hidden="true"
        >
          <span class="bento-skeleton absolute inset-0 block rounded-xl bg-muted"></span>
          <span class="bento-loaded absolute inset-2 block">
            <Emoji id="feather" size={40} alt="" />
          </span>
        </span>
        <span class="font-mono text-xs text-muted-foreground">
          {home.bento.layoutShift}
        </span>
      </div>
    </li>

    <li class={cardClass}>
      <div class="flex flex-col gap-1">
        <h3 class="text-lg font-extrabold text-balance">
          {home.bento.considerate.title}
        </h3>
        <p class="text-pretty text-muted-foreground">
          {home.bento.considerate.body}
        </p>
      </div>
      <div class={stageClass} style="--stage-base: 168" aria-hidden="true">
        <div class="flex items-center gap-4">
          <span class="bento-moon relative block size-10">
            <Emoji id="1f319_crescentmoon" size={40} autoPlay={false} alt="" />
            <Emoji
              id="1f319_crescentmoon"
              size={40}
              animationIterations="infinite"
              alt=""
              class="bento-motion-on absolute inset-0"
            />
          </span>
          <span class="relative block h-[26px] w-11 shrink-0">
            <span class="bento-switch fake-cursor-target absolute inset-0 block rounded-full border border-border bg-muted">
              <span class="bento-switch-track absolute inset-0 block rounded-full bg-primary"></span>
              <span class="bento-switch-thumb absolute top-[3px] left-[3px] block size-5 rounded-full bg-background shadow-sm"></span>
            </span>
            <span
              class={cursorMarkup}
              style="--cursor-x0: 52px; --cursor-y0: 40px; --cursor-x1: 20px; --cursor-y1: 12px; --cursor-x2: -8px; --cursor-y2: 44px"
            >
              <svg viewBox="0 0 16 16" class="size-full" fill="currentColor">
                <path
                  d="M2 1.5v11l3-2.8 2 4.3 2-.9-2-4.2h4.2z"
                  class="stroke-background"
                  stroke-width="1"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </span>
          </span>
          <span class="grid font-mono text-xs text-muted-foreground">
            <span class="bento-label-off col-start-1 row-start-1">
              {home.bento.reduceMotion.off}
            </span>
            <span class="bento-label-on col-start-1 row-start-1">
              {home.bento.reduceMotion.on}
            </span>
          </span>
        </div>
      </div>
    </li>

    <li class={`${cardClass} min-[860px]:col-span-2`}>
      <div class="flex flex-col gap-1">
        <h3 class="text-lg font-extrabold text-balance">
          {home.bento.credit.title}
        </h3>
        <p class="text-pretty text-muted-foreground">
          {home.bento.credit.body}
        </p>
      </div>
      <div
        class={`${stageClass} grid grid-cols-[1fr_auto_1fr] gap-2 px-3`}
        style="--stage-base: 168"
      >
        <span class="flex flex-col items-center gap-1 rounded-xl border border-border bg-card px-3 py-4 text-center">
          <span class="font-mono text-xs text-muted-foreground">
            {home.bento.artwork.label}
          </span>
          <span class="text-sm font-semibold text-balance">
            {home.bento.artwork.value}
          </span>
        </span>
        <svg
          viewBox="0 0 40 24"
          class="bento-link h-6 w-10 text-primary"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M2 12C14 2 26 22 38 12" pathLength="60"></path>
        </svg>
        <span class="flex flex-col items-center gap-1 rounded-xl border border-border bg-card px-3 py-4 text-center">
          <span class="font-mono text-xs text-muted-foreground">
            {home.bento.code.label}
          </span>
          <span class="text-sm font-semibold text-balance">
            {home.bento.code.value}
          </span>
        </span>
        <span
          class="pointer-events-none absolute right-[-8px] bottom-[-30px] block size-[86px]"
          aria-hidden="true"
        >
          <Emoji id="handshake" size={86} alt="" />
        </span>
      </div>
    </li>
  </ul>
</section>

<script>
  import { attachPillarSpotlight } from '../../scripts/pillar-spotlight'

  const cards = document.querySelectorAll<HTMLElement>(
    '[data-pillar-spotlight] > .spotlight',
  )
  attachPillarSpotlight(cards)
</script>
