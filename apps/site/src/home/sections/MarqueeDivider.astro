---
import Emoji from 'animated-fluent-emojis/astro'

import { loadPublicIndex } from '../../gallery/public-index'
import type { Locale } from '../../i18n/locales'
import {
  marqueeDurationSeconds,
  pickMarqueeEmojis,
  repeatMarqueeEmojis,
} from '../content'

interface Props {
  locale: Locale
}

const MARQUEE_EMOJI_SIZE = 34
const MARQUEE_GAP = 26
const MARQUEE_EMOJI_COUNT = 24
const MARQUEE_HALF_MIN_WIDTH = 2560

const index = await loadPublicIndex()
const half = repeatMarqueeEmojis(
  pickMarqueeEmojis(index, MARQUEE_EMOJI_COUNT),
  MARQUEE_EMOJI_SIZE + MARQUEE_GAP,
  MARQUEE_HALF_MIN_WIDTH,
)
const marqueeDuration = marqueeDurationSeconds(
  half.length * (MARQUEE_EMOJI_SIZE + MARQUEE_GAP),
).toFixed(2)
---

<section class="py-10 md:py-14" aria-hidden="true" data-marquee>
  <div
    class="marquee border-y border-border py-3 motion-reduce:flex motion-reduce:justify-center"
    data-marquee-row
  >
    <div
      class="marquee-track"
      data-direction="normal"
      style={{ '--marquee-duration': `${marqueeDuration}s` }}
    >
      {[false, true].map((duplicate) => (
        <div
          class="flex shrink-0 items-center gap-6.5 pr-6.5"
          aria-hidden={duplicate ? 'true' : undefined}
        >
          {half.map((emoji) => (
            <span
              class="flex size-8.5 shrink-0 items-center justify-center"
              data-marquee-emoji
            >
              <Emoji
                id={emoji.id}
                size={MARQUEE_EMOJI_SIZE}
                alt=""
                autoPlay={false}
              />
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
