---
import Emoji from 'animated-fluent-emojis/astro'

import { loadPublicIndex } from '../../gallery/public-index'
import { type Locale } from '../../i18n/locales'
import { getUi } from '../../i18n/ui'
import {
  buildCodeBlockTabs,
  SNIPPET_TABS,
  verifyShortcodeDemo,
} from '../content'
import InstallCard from '../InstallCard'
import { eyebrow, heading, section } from './styles'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { home } = getUi(locale)
const { install } = home

const PREVIEW_EMOJI_BY_KIND: Readonly<Record<string, string>> = {
  react: '269b_atomsymbol',
  vue: 'rainbow',
  svelte: 'fire',
  astro: 'launch',
  element: 'coffee',
}

const SHORTCODE_DEMO = [
  { code: 'fire', id: 'fire' },
  { code: 'grinningfacewithbigeyes', id: '1f603_grinningfacewithbigeyes' },
  { code: 'launch', id: 'launch' },
] as const

const index = await loadPublicIndex()
const indexIsFiltered = Boolean(process.env.SITE_EMOJI_SLUGS)
if (!indexIsFiltered) verifyShortcodeDemo(index, SHORTCODE_DEMO)

const fallbackEmoji = index.find((emoji) => emoji.id === '1f44b_wavinghand')

const previews: Record<string, string> = {}
const tabs = await Promise.all(
  SNIPPET_TABS.map(async ({ kind }) => {
    const previewId = PREVIEW_EMOJI_BY_KIND[kind]
    if (!previewId) throw new Error(`No install preview emoji for ${kind}`)
    const emoji =
      index.find(({ id }) => id === previewId) ??
      (indexIsFiltered ? fallbackEmoji : undefined)
    if (!emoji) throw new Error(`The public index has no ${previewId}`)
    previews[kind] = previewId
    const built = await buildCodeBlockTabs(emoji)
    const tab = built.find(({ id }) => id === kind)
    if (!tab) throw new Error(`No install snippet for ${kind}`)
    return tab
  }),
)

const steps = [
  { number: 1, ...install.steps.import },
  { number: 2, ...install.steps.render },
  { number: 3, ...install.steps.shortcodes },
]

const adapterRows = [['react'], ['vue', 'svelte'], ['astro', 'html']] as const
---

<section class={section} aria-labelledby="install-title">
  <div class="scroll-reveal">
    <p class={eyebrow}>{install.eyebrow}</p>
    <h2 id="install-title" class={`${heading} mb-2`}>
      {install.title}
    </h2>
    <p class="mb-6 text-pretty text-muted-foreground">{install.body}</p>
    <InstallCard
      client:visible
      tabs={tabs}
      previews={previews}
      labels={{
        tabsLabel: home.snippets.tabsLabel,
        copy: home.snippets.copy,
        copied: home.snippets.copied,
      }}
    />
  </div>

  <ol
    data-install-steps
    class="mt-3 grid list-none grid-cols-1 gap-3 p-0 min-[860px]:grid-cols-3"
  >
    {steps.map((step) => (
      <li class="scroll-reveal flex min-w-0 flex-col gap-3 rounded-2xl border border-border bg-card p-5">
        <span
          aria-hidden="true"
          class="grid size-7 place-items-center rounded-full bg-primary font-mono text-xs font-bold text-primary-foreground"
        >
          {step.number}
        </span>
        <div class="flex flex-col gap-1">
          <h3 class="text-lg font-extrabold text-balance">{step.title}</h3>
          <p class="text-pretty text-muted-foreground">{step.body}</p>
        </div>
        {step.number === 3 && (
          <div
            data-shortcode-demo
            aria-hidden="true"
            class="sc-demo mt-auto grid h-14 grid-cols-[minmax(0,1fr)] items-center overflow-hidden rounded-xl border border-border bg-muted/40 px-4"
          >
            {SHORTCODE_DEMO.map((shortcode) => (
              <span class="sc-item flex items-center gap-3">
                <code class="min-w-0 truncate font-mono text-xs font-semibold sm:text-sm">
                  :{shortcode.code}:
                </code>
                <span class="text-muted-foreground">→</span>
                <Emoji id={shortcode.id} size={36} alt="" autoPlay />
              </span>
            ))}
          </div>
        )}
      </li>
    ))}
  </ol>

  <figure
    data-install-architecture
    class="scroll-reveal mt-3 flex flex-col gap-4 rounded-2xl border border-border bg-card p-5"
  >
    <figcaption class="text-lg font-extrabold text-balance">
      {install.architecture.title}
    </figcaption>
    <div class="flex items-center gap-1 font-mono text-xs">
      <span class="grid h-9 place-items-center rounded-full bg-primary px-4 font-semibold text-primary-foreground">
        core
      </span>
      <svg
        aria-hidden="true"
        class="h-[124px] w-7 shrink-0 text-border"
        viewBox="0 0 28 124"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M0 62C14 62 14 18 28 18"></path>
        <path d="M0 62H28"></path>
        <path d="M0 62C14 62 14 106 28 106"></path>
      </svg>
      <ul class="flex list-none flex-col gap-2 p-0">
        {adapterRows.map((row) => (
          <li class="flex h-9 items-center gap-2">
            {row.map((name) => (
              <span class="grid h-9 place-items-center rounded-full border border-border bg-muted/40 px-3 font-semibold">
                {name}
              </span>
            ))}
          </li>
        ))}
      </ul>
    </div>
  </figure>
</section>

<style>
  .sc-demo > .sc-item {
    grid-area: 1 / 1;
    opacity: 0;
  }

  .sc-demo > .sc-item:last-child {
    opacity: 1;
  }

  @keyframes sc-cycle {
    0% {
      opacity: 0;
      translate: 0 6px;
    }
    6% {
      opacity: 1;
      translate: 0 0;
    }
    30% {
      opacity: 1;
      translate: 0 0;
    }
    36%,
    100% {
      opacity: 0;
      translate: 0 -6px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sc-demo > .sc-item {
      animation: sc-cycle 6s var(--ease-out-strong) infinite backwards;
    }

    .sc-demo > .sc-item:nth-child(2) {
      animation-delay: 2s;
    }

    .sc-demo > .sc-item:nth-child(3) {
      animation-delay: 4s;
    }
  }
</style>
