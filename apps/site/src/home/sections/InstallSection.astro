---
import Emoji from 'animated-fluent-emojis/astro'

import { loadPublicIndex } from '../../gallery/public-index'
import { type Locale } from '../../i18n/locales'
import { getUi } from '../../i18n/ui'
import {
  buildCodeBlockTabs,
  SNIPPET_TABS,
  verifyShortcodeDemo,
} from '../content'
import InstallCard from '../InstallCard'
import InstallStepCommand from '../InstallStepCommand'
import { eyebrow, heading, section } from './styles'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { home } = getUi(locale)
const { install } = home

const PREVIEW_EMOJI_BY_KIND: Readonly<Record<string, string>> = {
  react: '269b_atomsymbol',
  vue: 'rainbow',
  svelte: 'fire',
  astro: 'launch',
  element: 'coffee',
}

const SHORTCODE_DEMO = [
  { code: 'fire', id: 'fire' },
  { code: 'grinningfacewithbigeyes', id: '1f603_grinningfacewithbigeyes' },
  { code: 'launch', id: 'launch' },
] as const

const STEP_EMOJI_IDS = [
  '1f4e6_package',
  '1f50c_electricplug',
  '1f389_partypopper',
] as const

const index = await loadPublicIndex()
const indexIsFiltered = Boolean(process.env.SITE_EMOJI_SLUGS)
if (!indexIsFiltered) {
  verifyShortcodeDemo(index, SHORTCODE_DEMO)
  verifyShortcodeDemo(
    index,
    STEP_EMOJI_IDS.map((id) => ({ code: id, id })),
  )
}

const fallbackEmoji = index.find((emoji) => emoji.id === '1f44b_wavinghand')

const previews: Record<string, string> = {}
const tabs = await Promise.all(
  SNIPPET_TABS.map(async ({ kind }) => {
    const previewId = PREVIEW_EMOJI_BY_KIND[kind]
    if (!previewId) throw new Error(`No install preview emoji for ${kind}`)
    const emoji =
      index.find(({ id }) => id === previewId) ??
      (indexIsFiltered ? fallbackEmoji : undefined)
    if (!emoji) throw new Error(`The public index has no ${previewId}`)
    previews[kind] = previewId
    const built = await buildCodeBlockTabs(emoji)
    const tab = built.find(({ id }) => id === kind)
    if (!tab) throw new Error(`No install snippet for ${kind}`)
    return tab
  }),
)

const steps = [
  { number: 1, emojiId: STEP_EMOJI_IDS[0], title: install.stepLabels.install },
  {
    number: 2,
    emojiId: STEP_EMOJI_IDS[1],
    title: install.stepLabels.import,
    line: "import { Emoji } from 'animated-fluent-emojis/react'",
  },
  {
    number: 3,
    emojiId: STEP_EMOJI_IDS[2],
    title: install.stepLabels.use,
    line: '<Emoji id="fire" size={64} />',
  },
]

const { ready } = home.hero
const slug = (...names: string[]) =>
  names.map((name) => name.toLowerCase()).join(' / ')
const adapterCells = [
  { label: 'core', title: install.architecture.core, line: 'manifest + CSS' },
  { label: slug(ready.react), title: ready.react, line: ready.status },
  {
    label: slug(ready.vue, ready.svelte),
    title: [ready.vue, ready.svelte].join(', '),
    line: ready.status,
  },
  {
    label: slug(ready.astro, ready.html),
    title: [ready.astro, ready.html].join(', '),
    line: ready.status,
  },
]
---

<section class={section} aria-labelledby="install-title">
  <div class="scroll-reveal">
    <p class={eyebrow}>{install.eyebrow}</p>
    <h2 id="install-title" class={`${heading} mb-2`}>
      {install.title}
    </h2>
    <p class="mb-6 text-pretty text-muted-foreground">{install.body}</p>
    <InstallCard
      client:visible
      tabs={tabs}
      previews={previews}
      labels={{
        tabsLabel: home.snippets.tabsLabel,
        copy: home.snippets.copy,
        copied: home.snippets.copied,
      }}
    />
  </div>

  <ol
    data-install-steps
    class="mt-3 grid list-none grid-cols-1 gap-3 p-0 min-[860px]:grid-cols-3"
  >
    {steps.map((step) => (
      <li
        class="scroll-reveal min-w-0"
        style={{ '--step-index': step.number - 1 }}
      >
        <div class="install-step flex h-full min-w-0 flex-col gap-3 rounded-2xl border border-border bg-card p-5">
          <span
            aria-hidden="true"
            class="step-emoji grid size-12 place-items-center"
          >
            <Emoji id={step.emojiId} size={40} alt="" autoPlay />
          </span>
          <div class="flex min-w-0 flex-col gap-1">
            <h3 class="text-lg font-extrabold text-balance">{step.title}</h3>
            {step.number === 1 ? (
              <InstallStepCommand client:visible />
            ) : (
              <code class="block min-w-0 truncate font-mono text-xs text-muted-foreground">
                {step.line}
              </code>
            )}
          </div>
        </div>
      </li>
    ))}
  </ol>

  <div class="mt-3 grid grid-cols-1 gap-3 min-[860px]:grid-cols-2">
    <div
      data-shortcode-panel
      class="scroll-reveal flex flex-col gap-3 rounded-2xl border border-border bg-card p-5"
    >
      <p class="m-0 font-mono text-micro tracking-widest text-muted-foreground uppercase">
        {install.steps.shortcodes.title}
      </p>
      <div
        data-shortcode-demo
        aria-hidden="true"
        class="sc-demo grid min-h-12 grid-cols-1 items-center overflow-hidden rounded-xl border border-border bg-background/60 px-4 py-2"
      >
        {SHORTCODE_DEMO.map((shortcode, position) => (
          <span
            class="sc-item flex items-center gap-2 sm:gap-3"
            style={{
              '--chars': shortcode.code.length + 2,
              '--delay': `${position * 4}s`,
            }}
          >
            <code class="sc-text block overflow-hidden font-mono text-meta font-semibold whitespace-nowrap sm:text-base">
              :{shortcode.code}:
            </code>
            <span class="sc-emoji">
              <Emoji id={shortcode.id} size={32} alt="" autoPlay />
            </span>
          </span>
        ))}
      </div>
      <p class="m-0 text-pretty text-sm text-muted-foreground">
        {install.steps.shortcodes.body}
      </p>
    </div>

    <figure
      data-install-architecture
      class="scroll-reveal m-0 flex flex-col gap-3 rounded-2xl border border-border bg-card p-5"
    >
      <figcaption class="font-mono text-micro tracking-widest text-muted-foreground uppercase">
        {install.architecture.title}
      </figcaption>
      <ul class="m-0 grid list-none grid-cols-2 gap-2 p-0">
        {adapterCells.map((cell, position) => (
          <li
            class={`flex min-w-0 flex-col gap-0.5 rounded-xl border bg-background/60 p-3 text-sm ${position === 0 ? 'border-primary' : 'border-border'}`}
          >
            <span class="font-mono text-micro tracking-widest text-muted-foreground uppercase">
              {cell.label}
            </span>
            <span class="font-extrabold">{cell.title}</span>
            <span class="font-mono text-xs font-semibold text-primary">
              {cell.line}
            </span>
          </li>
        ))}
      </ul>
    </figure>
  </div>
</section>
