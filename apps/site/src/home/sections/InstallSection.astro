---
import Emoji from 'animated-fluent-emojis/astro'

import { loadPublicIndex } from '../../gallery/public-index'
import { type Locale } from '../../i18n/locales'
import { getUi } from '../../i18n/ui'
import {
  buildCodeBlockTabs,
  SNIPPET_TABS,
  verifyShortcodeDemo,
} from '../content'
import InstallCard from '../InstallCard'
import InstallStepCommand from '../InstallStepCommand'
import { eyebrow, heading, section } from './styles'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { home } = getUi(locale)
const { install } = home

const PREVIEW_EMOJI_BY_KIND: Readonly<Record<string, string>> = {
  react: '269b_atomsymbol',
  vue: 'rainbow',
  svelte: 'fire',
  astro: 'launch',
  element: 'coffee',
}

const SHORTCODE_DEMO = [
  { code: 'fire', id: 'fire' },
  { code: 'launch', id: 'launch' },
  { code: 'grinningfacewithbigeyes', id: '1f603_grinningfacewithbigeyes' },
] as const

const STEP_EMOJI_IDS = [
  '1f4e6_package',
  '1f50c_electricplug',
  '1f389_partypopper',
] as const

const index = await loadPublicIndex()
const indexIsFiltered = Boolean(process.env.SITE_EMOJI_SLUGS)
if (!indexIsFiltered) {
  verifyShortcodeDemo(index, SHORTCODE_DEMO)
  verifyShortcodeDemo(
    index,
    STEP_EMOJI_IDS.map((id) => ({ code: id, id })),
  )
}

const fallbackEmoji = index.find((emoji) => emoji.id === '1f44b_wavinghand')

const previews: Record<string, string> = {}
const tabs = await Promise.all(
  SNIPPET_TABS.map(async ({ kind }) => {
    const previewId = PREVIEW_EMOJI_BY_KIND[kind]
    if (!previewId) throw new Error(`No install preview emoji for ${kind}`)
    const emoji =
      index.find(({ id }) => id === previewId) ??
      (indexIsFiltered ? fallbackEmoji : undefined)
    if (!emoji) throw new Error(`The public index has no ${previewId}`)
    previews[kind] = previewId
    const built = await buildCodeBlockTabs(emoji)
    const tab = built.find(({ id }) => id === kind)
    if (!tab) throw new Error(`No install snippet for ${kind}`)
    return tab
  }),
)

const steps = [
  { number: 1, emojiId: STEP_EMOJI_IDS[0], ...install.steps.import },
  { number: 2, emojiId: STEP_EMOJI_IDS[1], ...install.steps.render },
  { number: 3, emojiId: STEP_EMOJI_IDS[2], ...install.steps.shortcodes },
]

const adapterTiles = [
  { label: 'core', names: 'manifest + CSS', core: true },
  { label: 'react', names: 'React', core: false },
  { label: 'vue / svelte', names: 'Vue, Svelte', core: false },
  { label: 'astro / html', names: 'Astro, HTML', core: false },
] as const
---

<section class={section} aria-labelledby="install-title">
  <div class="scroll-reveal">
    <p class={eyebrow}>{install.eyebrow}</p>
    <h2 id="install-title" class={`${heading} mb-2`}>
      {install.title}
    </h2>
    <p class="mb-6 text-pretty text-muted-foreground">{install.body}</p>
    <InstallCard
      client:visible
      tabs={tabs}
      previews={previews}
      labels={{
        tabsLabel: home.snippets.tabsLabel,
        copy: home.snippets.copy,
        copied: home.snippets.copied,
      }}
    />
  </div>

  <ol
    data-install-steps
    class="mt-3 grid list-none grid-cols-1 gap-3 p-0 min-[860px]:grid-cols-3"
  >
    {steps.map((step) => (
      <li
        class="install-step scroll-reveal flex min-w-0 flex-col gap-3 rounded-2xl border border-border bg-card p-5"
        style={`--step-index: ${step.number - 1}`}
      >
        <span
          aria-hidden="true"
          class="step-emoji grid size-12 place-items-center"
        >
          <Emoji id={step.emojiId} size={40} alt="" autoPlay />
        </span>
        <div class="flex flex-col gap-1">
          <h3 class="text-lg font-extrabold text-balance">{step.title}</h3>
          <p class="text-pretty text-muted-foreground">{step.body}</p>
        </div>
        {step.number === 1 && <InstallStepCommand client:visible />}
      </li>
    ))}
  </ol>

  <div class="mt-3 grid grid-cols-1 gap-3 min-[860px]:grid-cols-2">
    <div
      data-shortcode-demo
      aria-hidden="true"
      class="sc-demo scroll-reveal grid min-h-32 grid-cols-[minmax(0,1fr)] place-items-center overflow-hidden rounded-2xl border border-border bg-card p-5"
    >
      {SHORTCODE_DEMO.map((shortcode, position) => (
        <span
          class="sc-item flex items-center gap-2 sm:gap-4"
          style={`--chars: ${shortcode.code.length + 2}; --delay: ${position * 4}s`}
        >
          <code class="sc-text block overflow-hidden font-mono text-[13px] font-semibold whitespace-nowrap sm:text-lg">
            :{shortcode.code}:
          </code>
          <span class="sc-emoji">
            <Emoji id={shortcode.id} size={56} alt="" autoPlay />
          </span>
        </span>
      ))}
    </div>

    <figure
      data-install-architecture
      class="scroll-reveal flex flex-col gap-4 rounded-2xl border border-border bg-card p-5"
    >
      <figcaption class="text-lg font-extrabold text-balance">
        {install.architecture.title}
      </figcaption>
      <ul class="m-0 grid list-none grid-cols-2 gap-2 p-0">
        {adapterTiles.map((tile) => (
          <li
            class={`flex flex-col gap-0.5 rounded-xl border bg-background/60 p-3 text-sm ${tile.core ? 'border-primary' : 'border-border'}`}
          >
            <span class="font-mono text-[10px] tracking-widest text-muted-foreground uppercase">
              {tile.label}
            </span>
            <span class="font-semibold">{tile.names}</span>
          </li>
        ))}
      </ul>
    </figure>
  </div>
</section>

<style>
  @keyframes step-lit {
    0%,
    33% {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px color-mix(in oklab, var(--primary) 18%, transparent);
    }
    34%,
    100% {
      border-color: var(--border);
      box-shadow: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .install-step {
      animation: step-lit 6s infinite;
      animation-delay: calc(var(--step-index, 0) * 2s);
    }
  }

  @keyframes lit-e {
    0%,
    33% {
      scale: 1.12;
      rotate: -6deg;
    }
    34%,
    100% {
      scale: 1;
      rotate: 0deg;
    }
  }

  .sc-demo > .sc-item {
    grid-area: 1 / 1;
    opacity: 0;
  }

  .sc-demo > .sc-item:last-child {
    opacity: 1;
  }

  .sc-text {
    width: calc(var(--chars) * 1ch);
    border-right: 2px solid transparent;
  }

  @keyframes sc-show {
    0% {
      opacity: 0;
    }
    0.1%,
    32% {
      opacity: 1;
    }
    33%,
    100% {
      opacity: 0;
    }
  }

  @keyframes sc-type {
    0% {
      width: 0;
    }
    14%,
    100% {
      width: calc(var(--chars) * 1ch);
    }
  }

  @keyframes sc-caret {
    0%,
    100% {
      border-right-color: var(--primary);
    }
    50% {
      border-right-color: transparent;
    }
  }

  @keyframes sc-pop {
    0%,
    14% {
      opacity: 0;
      scale: 0.6;
    }
    19% {
      opacity: 1;
      scale: 1.12;
    }
    22%,
    32% {
      opacity: 1;
      scale: 1;
    }
    33%,
    100% {
      opacity: 0;
      scale: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .step-emoji {
      animation: lit-e 6s var(--ease-out-strong) infinite;
      animation-delay: calc(var(--step-index, 0) * 2s);
    }

    .sc-demo > .sc-item {
      animation: sc-show 12s linear infinite backwards;
      animation-delay: var(--delay, 0s);
    }

    .sc-text {
      animation:
        sc-type 12s steps(var(--chars), end) infinite backwards,
        sc-caret 0.8s steps(1) infinite;
      animation-delay: var(--delay, 0s), 0s;
    }

    .sc-emoji {
      animation: sc-pop 12s var(--ease-out-strong) infinite backwards;
      animation-delay: var(--delay, 0s);
    }
  }
</style>
