---
import { Icon } from '@astrojs/starlight/components'

import type { Locale } from '../../i18n/locales'
import { getUi } from '../../i18n/ui'
import { externalLinkAttributes } from '../../site-links'

const { editUrl, lang } = Astro.locals.starlightRoute
const { common } = getUi(lang as Locale)
const externalAttributes = externalLinkAttributes()
---

{editUrl && (
  <a href={editUrl} class="sl-flex print:hidden" {...externalAttributes}>
    <Icon name="pencil" size="1.2em" />
    {Astro.locals.t('page.editLink')}
    <span class="sr-only"> ({common.opensInNewTab})</span>
  </a>
)}

<style>
  @layer starlight.core {
    a {
      gap: 0.5rem;
      align-items: center;
      text-decoration: none;
      color: var(--sl-color-gray-3);
    }
    @media (hover: hover) and (pointer: fine) {
      a:hover {
        color: var(--sl-color-white);
      }
    }
  }
</style>
