---
const { dir, pagination } = Astro.locals.starlightRoute
const { prev, next } = pagination
---

{(prev || next) && (
  <div class="pagination-nav print:hidden" dir={dir}>
    {prev && (
      <a href={prev.href} rel="prev">
        <span class="pagination-label">
          {Astro.locals.t('page.previousLink')}
        </span>
        <span class="pagination-title">{prev.label}</span>
      </a>
    )}
    {next && (
      <a href={next.href} rel="next">
        <span class="pagination-label">{Astro.locals.t('page.nextLink')}</span>
        <span class="pagination-title">{next.label}</span>
      </a>
    )}
  </div>
)}
